{# Port of app/super-admin/banner/page.tsx #}
{% extends 'super_admin/layout.html.twig' %}
{% block pages %}super-admin-banner{% endblock %}
{% block content %}
<div x-data="bannerManagement">
    <template x-if="loading">
        <div class="h-[60vh] flex flex-col items-center justify-center space-y-4">
            <twig:ux:icon name="lucide:loader-circle" class="h-10 w-10 animate-spin text-primary/40" />
            <div class="text-sm font-medium text-muted-foreground animate-pulse">Synchronizing banner states...</div>
        </div>
    </template>
    <template x-if="!loading">
        <div class="space-y-8 animate-in fade-in duration-700">
            <div class="flex items-center justify-between pb-4 border-b">
                <div>
                    <h1 class="text-3xl font-bold tracking-tight text-foreground">Banner Management</h1>
                    <p class="text-muted-foreground">Toggle promotional visibility per company node.</p>
                </div>
                <div class="h-12 w-12 bg-primary/10 rounded-2xl flex items-center justify-center text-primary shadow-sm">
                    <twig:ux:icon name="lucide:megaphone" class="h-6 w-6" />
                </div>
            </div>
            <twig:Card class="rounded-2xl border border-border/50 bg-card shadow-sm overflow-hidden">
                <twig:Table>
                    <twig:Table:Header class="bg-secondary/30">
                        <twig:Table:Row>
                            <twig:Table:Head class="font-bold text-[11px] uppercase tracking-wider py-4 pl-6 text-muted-foreground">Company</twig:Table:Head>
                            <twig:Table:Head class="font-bold text-[11px] uppercase tracking-wider py-4 text-center text-muted-foreground">Status</twig:Table:Head>
                            <twig:Table:Head class="font-bold text-[11px] uppercase tracking-wider py-4 pr-6 text-right text-muted-foreground">Toggle Visibility</twig:Table:Head>
                        </twig:Table:Row>
                    </twig:Table:Header>
                    <twig:Table:Body>
                        <template x-for="company in companies" :key="company.id">
                            <twig:Table:Row class="hover:bg-secondary/20 transition-colors border-border/50">
                                <twig:Table:Cell class="py-4 pl-6">
                                    <div class="flex items-center gap-3">
                                        <div class="h-10 w-10 bg-primary/10 rounded-xl flex items-center justify-center text-primary font-bold" x-text="company.name[0]"></div>
                                        <div>
                                            <p class="font-semibold text-sm" x-text="company.name"></p>
                                            <p class="text-[10px] text-muted-foreground font-medium uppercase tracking-tighter" x-text="`Node ID: ${company.id}`"></p>
                                        </div>
                                    </div>
                                </twig:Table:Cell>
                                <twig:Table:Cell class="py-4 text-center">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-widest"
                                          :class="isEnabled(company) ? 'bg-emerald-500/10 text-emerald-500 border border-emerald-500/20' : 'bg-red-500/10 text-red-500 border border-red-500/20'"
                                          x-text="isEnabled(company) ? 'ACTIVE' : 'DISABLED'"></span>
                                </twig:Table:Cell>
                                <twig:Table:Cell class="py-4 pr-6 text-right">
                                    <div class="flex items-center justify-end gap-3">
                                        <template x-if="toggling === company.id"><twig:ux:icon name="lucide:loader-circle" class="h-4 w-4 animate-spin text-primary/40" /></template>
                                        <twig:Switch checked="isEnabled(company)" onChange="handleToggleBanner(company.id, isEnabled(company))" disabled="toggling === company.id" class="data-[state=checked]:bg-primary" />
                                    </div>
                                </twig:Table:Cell>
                            </twig:Table:Row>
                        </template>
                    </twig:Table:Body>
                </twig:Table>
            </twig:Card>
        </div>
    </template>
</div>
{% endblock %}
