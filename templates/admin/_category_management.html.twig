{# Port of components/CategoryManagement.tsx (Alpine component: assets/lib/category-management.js) #}
<div id="category-section" class="space-y-6" x-data="categoryManagement">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-black text-foreground tracking-tight uppercase italic flex items-center gap-3">
                <twig:ux:icon name="lucide:settings-2" class="h-6 w-6 text-primary not-italic" />
                Category <span class="text-primary not-italic">Management</span>
            </h2>
            <p class="text-muted-foreground text-[10px] font-black uppercase tracking-widest mt-1">Organize your reagents and link them to vendors.</p>
        </div>
        <div class="flex items-center gap-4">
            <div class="relative w-64">
                <twig:ux:icon name="lucide:search" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
                <twig:Input placeholder="Search categories..." x-model="searchTerm"
                    class="bg-card border-border rounded-xl h-11 pl-10 pr-4 font-bold focus:ring-primary/20 transition-all placeholder:text-[10px] placeholder:uppercase placeholder:tracking-widest" />
            </div>
            <twig:Button x-on:click="openForm()" class="bg-primary hover:opacity-90 text-primary-foreground font-black rounded-xl gap-2 h-11 px-6 shadow-lg shadow-primary/10">
                <twig:ux:icon name="lucide:plus" class="h-4 w-4" />
                CREATE NEW CATEGORY
            </twig:Button>
        </div>
    </div>

    <twig:Card class="bg-card border-border rounded-4xl overflow-hidden shadow-sm">
        <twig:Table>
            <twig:Table:Header class="bg-secondary/10">
                <twig:Table:Row class="hover:bg-transparent border-border">
                    <twig:Table:Head class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground">Category Name</twig:Table:Head>
                    <twig:Table:Head class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground">Linked Vendor</twig:Table:Head>
                    <twig:Table:Head class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground text-center">Reagents</twig:Table:Head>
                    <twig:Table:Head class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground text-right">Actions</twig:Table:Head>
                </twig:Table:Row>
            </twig:Table:Header>
            <twig:Table:Body>
                <template x-if="loading">
                    <twig:Table:Row>
                        <twig:Table:Cell colspan="4" class="h-40 text-center">
                            <div class="flex flex-col items-center gap-2">
                                <twig:ux:icon name="lucide:loader-circle" class="h-8 w-8 text-primary animate-spin" />
                                <p class="text-[10px] font-black text-muted-foreground uppercase tracking-widest">Loading categories...</p>
                            </div>
                        </twig:Table:Cell>
                    </twig:Table:Row>
                </template>
                <template x-if="!loading && categories.length === 0">
                    <twig:Table:Row>
                        <twig:Table:Cell colspan="4" class="h-40 text-center text-muted-foreground font-medium uppercase text-[10px] tracking-widest">No categories created yet.</twig:Table:Cell>
                    </twig:Table:Row>
                </template>
                <template x-for="cat in (loading ? [] : categories)" :key="cat.id">
                    <twig:Table:Row class="hover:bg-secondary/20 transition-all border-border">
                        <td class="p-6">
                            <div class="flex items-center gap-3">
                                <div class="h-10 w-10 rounded-xl bg-primary/10 flex items-center justify-center font-black text-primary text-sm shadow-inner" x-text="cat.name[0].toUpperCase()"></div>
                                <span class="font-bold text-foreground" x-text="cat.name"></span>
                            </div>
                        </td>
                        <td class="p-6">
                            <template x-if="cat.vendor">
                                <div class="flex items-center gap-2 group cursor-default">
                                    <div class="px-3 py-1 bg-indigo-500/10 border border-indigo-500/20 rounded-lg flex items-center gap-2">
                                        <twig:ux:icon name="lucide:building-2" class="h-3 w-3 text-indigo-400" />
                                        <span class="text-[11px] font-black text-indigo-400 uppercase tracking-wider" x-text="cat.vendor.name"></span>
                                    </div>
                                </div>
                            </template>
                            <template x-if="!cat.vendor">
                                <span class="text-[10px] font-bold text-muted-foreground opacity-30 italic">Not Linked</span>
                            </template>
                        </td>
                        <td class="p-6 text-center">
                            <div class="flex flex-col items-center">
                                <span class="font-black text-base text-foreground" x-text="cat.productCount"></span>
                                <span class="text-[8px] font-black text-muted-foreground uppercase tracking-tighter">TOTAL STOCK ITEMS</span>
                            </div>
                        </td>
                        <td class="p-6 text-right space-x-2">
                            <twig:Button variant="ghost" size="icon" x-on:click="openProductAssignment(cat)" title="Add Products" class="h-9 w-9 text-muted-foreground hover:bg-indigo-500/10 hover:text-indigo-400 rounded-lg">
                                <twig:ux:icon name="lucide:plus" class="h-4 w-4" />
                            </twig:Button><twig:Button variant="ghost" size="icon" x-on:click="openForm(cat)" class="h-9 w-9 text-muted-foreground hover:bg-primary/10 hover:text-primary rounded-lg">
                                <twig:ux:icon name="lucide:pen" class="h-4 w-4" />
                            </twig:Button><twig:Button variant="ghost" size="icon" x-on:click="handleDelete(cat.id)" class="h-9 w-9 text-muted-foreground hover:bg-red-500/10 hover:text-red-500 rounded-lg">
                                <twig:ux:icon name="lucide:trash-2" class="h-4 w-4" />
                            </twig:Button>
                        </td>
                    </twig:Table:Row>
                </template>
            </twig:Table:Body>
        </twig:Table>

        <template x-if="!loading">
            <div class="p-4 bg-secondary/10 border-t border-border flex items-center justify-between">
                <div class="text-[10px] font-black uppercase tracking-widest text-muted-foreground ml-2">
                    Showing <span class="text-primary" x-text="categories.length"></span> of <span x-text="totalItems"></span> categories
                    <template x-if="totalPages > 1"><span class="ml-2 opacity-50" x-text="`| Page ${page} of ${totalPages}`"></span></template>
                </div>
                <template x-if="totalPages > 1">
                    <div class="flex items-center gap-2">
                        <twig:Button variant="ghost" size="icon" x-on:click="page = 1" disabledWhen="page === 1" class="h-8 w-8 rounded-lg"><twig:ux:icon name="lucide:chevrons-left" class="h-4 w-4" /></twig:Button>
                        <twig:Button variant="ghost" size="icon" x-on:click="page = Math.max(1, page - 1)" disabledWhen="page === 1" class="h-8 w-8 rounded-lg"><twig:ux:icon name="lucide:chevron-left" class="h-4 w-4" /></twig:Button>
                        <div class="flex items-center gap-1 mx-2">
                            <template x-for="item in pageItems" :key="item.p">
                                <div class="flex items-center">
                                    <template x-if="item.gap"><span class="text-muted-foreground px-1">...</span></template>
                                    <template x-if="item.p === page">
                                        <twig:Button variant="primary" size="sm" x-on:click="page = item.p" class="h-8 w-8 rounded-lg text-[10px] font-black bg-primary text-primary-foreground shadow-lg shadow-primary/20" x-text="item.p"></twig:Button>
                                    </template>
                                    <template x-if="item.p !== page">
                                        <twig:Button variant="ghost" size="sm" x-on:click="page = item.p" class="h-8 w-8 rounded-lg text-[10px] font-black text-muted-foreground hover:bg-primary/10 hover:text-primary" x-text="item.p"></twig:Button>
                                    </template>
                                </div>
                            </template>
                        </div>
                        <twig:Button variant="ghost" size="icon" x-on:click="page = Math.min(totalPages, page + 1)" disabledWhen="page === totalPages" class="h-8 w-8 rounded-lg"><twig:ux:icon name="lucide:chevron-right" class="h-4 w-4" /></twig:Button>
                        <twig:Button variant="ghost" size="icon" x-on:click="page = totalPages" disabledWhen="page === totalPages" class="h-8 w-8 rounded-lg"><twig:ux:icon name="lucide:chevrons-right" class="h-4 w-4" /></twig:Button>
                    </div>
                </template>
            </div>
        </template>
    </twig:Card>

    <template x-if="isFormOpen">
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
            <div class="absolute inset-0 bg-background/80 backdrop-blur-sm" @click="isFormOpen = false"></div>
            <twig:Card class="relative w-full max-w-md bg-card border-border rounded-[2.5rem] shadow-2xl animate-in zoom-in-95 duration-200">
                <twig:Card:Header class="p-8 border-b border-border">
                    <twig:Card:Title class="text-xl font-black uppercase italic tracking-tighter flex items-center gap-3">
                        <template x-if="editingCategory"><twig:ux:icon name="lucide:pen" class="h-5 w-5 text-primary not-italic" /></template>
                        <template x-if="!editingCategory"><twig:ux:icon name="lucide:plus" class="h-5 w-5 text-primary not-italic" /></template>
                        <span x-text="editingCategory ? 'Edit' : 'Create'"></span> <span class="text-primary not-italic font-black">Category</span>
                    </twig:Card:Title>
                </twig:Card:Header>
                <twig:Card:Content class="p-8 space-y-6">
                    <form @submit.prevent="handleSubmit()" class="space-y-6">
                        <div class="space-y-2">
                            <twig:Label class="text-[10px] font-black uppercase tracking-widest text-muted-foreground ml-1">Category Name</twig:Label>
                            <twig:Input x-model="formName" placeholder="Enter category name..." class="bg-secondary/30 border-border rounded-xl h-12 font-bold px-4 focus:ring-primary/20" />
                        </div>
                        <div class="space-y-2">
                            <twig:Label class="text-[10px] font-black uppercase tracking-widest text-muted-foreground ml-1">Link to Vendor (Optional)</twig:Label>
                            <twig:Select model="formVendorId" options="vendorOptions" placeholder="Select Vendor"
                                triggerClass="bg-secondary/30 border-border h-12 rounded-xl px-4 font-bold" contentClass="dark:bg-slate-900 border-border" />
                        </div>
                        <div class="flex gap-4 pt-4">
                            <twig:Button type="button" variant="outline" x-on:click="isFormOpen = false" class="flex-1 h-12 rounded-xl font-black uppercase tracking-widest border-border">Cancel</twig:Button>
                            <twig:Button disabledWhen="submitting" class="flex-1 h-12 rounded-xl font-black uppercase tracking-widest bg-primary text-primary-foreground shadow-lg shadow-primary/10">
                                <template x-if="submitting"><twig:ux:icon name="lucide:loader-circle" class="h-4 w-4 animate-spin" /></template>
                                <template x-if="!submitting"><span x-text="editingCategory ? 'SAVE CHANGES' : 'CREATE CATEGORY'"></span></template>
                            </twig:Button>
                        </div>
                    </form>
                </twig:Card:Content>
            </twig:Card>
        </div>
    </template>

    <template x-if="isProductModalOpen">
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
            <div class="absolute inset-0 bg-background/80 backdrop-blur-sm" @click="isProductModalOpen = false"></div>
            <twig:Card class="relative w-full max-w-2xl bg-card border-border rounded-[2.5rem] shadow-2xl animate-in zoom-in-95 duration-200">
                <twig:Card:Header class="p-8 border-b border-border">
                    <twig:Card:Title class="text-xl font-black uppercase italic tracking-tighter flex items-center gap-3">
                        <twig:ux:icon name="lucide:package" class="h-5 w-5 text-indigo-400 not-italic" />
                        Assign Reagents to <span class="text-indigo-400 not-italic font-black" x-text="selectedCategoryForProducts?.name"></span>
                    </twig:Card:Title>
                </twig:Card:Header>
                <twig:Card:Content class="p-8 space-y-6">
                    <div class="max-h-[400px] overflow-y-auto pr-2 custom-scrollbar">
                        <div class="grid grid-cols-1 gap-2">
                            <template x-if="unassignedProducts.length === 0">
                                <p class="text-center py-10 text-muted-foreground font-bold uppercase text-[10px] tracking-widest italic opacity-50">All reagents already assigned or none available.</p>
                            </template>
                            <template x-for="p in unassignedProducts" :key="p.id">
                                <div @click="toggleProductSelection(p.id)" class="p-4 border rounded-2xl flex items-center justify-between cursor-pointer transition-all duration-300"
                                     :class="selectedProductIds.includes(p.id) ? 'bg-primary/10 border-primary shadow-inner scale-[0.98]' : 'bg-secondary/20 border-border hover:border-primary/30'">
                                    <div class="flex items-center gap-3">
                                        <div class="h-8 w-8 rounded-lg flex items-center justify-center font-black text-xs transition-colors"
                                             :class="selectedProductIds.includes(p.id) ? 'bg-primary text-primary-foreground' : 'bg-secondary text-muted-foreground'" x-text="p.name[0].toUpperCase()"></div>
                                        <div>
                                            <p class="font-bold text-sm" x-text="p.name"></p>
                                            <p class="text-[9px] font-black uppercase tracking-widest opacity-40" x-text="`Currently: ${p.category?.name || 'Uncategorized'}`"></p>
                                        </div>
                                    </div>
                                    <div class="transition-all duration-500">
                                        <template x-if="selectedProductIds.includes(p.id)"><twig:ux:icon name="lucide:circle-check" class="h-5 w-5 text-primary animate-in zoom-in spin-in-12 border-none" /></template>
                                        <template x-if="!selectedProductIds.includes(p.id)"><div class="h-5 w-5 rounded-full border-2 border-muted-foreground/20"></div></template>
                                    </div>
                                </div>
                            </template>
                        </div>
                    </div>
                    <div class="flex items-center justify-between pt-4 gap-4">
                        <p class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">Selected: <span class="text-primary font-black" x-text="selectedProductIds.length"></span> items</p>
                        <div class="flex gap-3">
                            <twig:Button variant="ghost" x-on:click="isProductModalOpen = false" class="h-11 rounded-xl font-black uppercase tracking-widest px-6">Cancel</twig:Button>
                            <twig:Button x-on:click="handleAssignProducts()" disabledWhen="selectedProductIds.length === 0 || assigningProducts" class="h-11 rounded-xl font-black uppercase tracking-widest bg-indigo-500 hover:bg-indigo-600 text-white px-8 shadow-lg shadow-indigo-500/20">
                                <template x-if="assigningProducts"><twig:ux:icon name="lucide:loader-circle" class="h-4 w-4 animate-spin" /></template>
                                <template x-if="!assigningProducts"><span>ASSIGN REAGENTS</span></template>
                            </twig:Button>
                        </div>
                    </div>
                </twig:Card:Content>
            </twig:Card>
        </div>
    </template>
</div>
