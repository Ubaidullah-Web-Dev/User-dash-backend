{# Port of app/(tenant)/[companySlug]/admin/orders/new/page.tsx #}
{% extends 'admin/layout.html.twig' %}
{% block pages %}admin-orders-new{% endblock %}
{% set labelClass = 'text-[10px] font-black uppercase tracking-widest text-muted-foreground ml-1' %}
{% block content %}
<div class="space-y-12 animate-in fade-in duration-700 pb-20" x-data="newOrderPage">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-4xl font-black text-foreground tracking-tighter mb-2 italic uppercase">CREATE <span class="text-primary not-italic">New Order</span></h1>
            <p class="text-muted-foreground font-medium uppercase text-[10px] tracking-widest leading-loose">Select a vendor and add products to your restock request.</p>
        </div>
        <twig:Button variant="ghost" x-on:click="toOrders()" class="text-muted-foreground hover:text-primary font-black text-[10px] tracking-widest uppercase items-center">
            <twig:ux:icon name="lucide:arrow-left" class="mr-2 h-4 w-4" /> Back to Orders
        </twig:Button>
    </div>

    <twig:Card class="bg-card border-border rounded-[2.5rem] shadow-xl border-t-4 border-t-primary/20">
        <twig:Card:Header class="p-8 border-b border-border bg-secondary/10 rounded-t-[2.5rem]">
            <twig:Card:Title class="text-lg font-black tracking-tight text-foreground uppercase italic flex items-center">
                <twig:ux:icon name="lucide:search" class="mr-3 h-5 w-5 text-primary" />
                Supplier Search
            </twig:Card:Title>
        </twig:Card:Header>
        <twig:Card:Content class="p-8">
            <div x-ref="vendor" class="w-full space-y-3 relative">
                <twig:Label class="{{ labelClass }}">Vendor Name or Company</twig:Label>
                <div class="relative">
                    <twig:Input placeholder="Start typing to search vendors..." x-model="vendorSearch" x-on:focus="onVendorFocus()" x-on:input="onVendorInput()"
                        class="bg-secondary/50 border-border rounded-xl h-12 font-bold focus:ring-primary/20 pr-10" />
                    <template x-if="isSearching">
                        <div class="absolute right-3 top-1/2 -translate-y-1/2">
                            <div class="animate-spin h-4 w-4 border-2 border-primary border-t-transparent rounded-full"></div>
                        </div>
                    </template>
                </div>

                <template x-if="showVendorSuggestions && vendors.length > 0">
                    <div class="absolute z-50 left-0 right-0 top-full mt-2 bg-card/95 backdrop-blur-md border border-border rounded-2xl shadow-2xl overflow-hidden max-h-60 overflow-y-auto custom-scrollbar ring-1 ring-black/5">
                        <template x-for="vendor in vendors" :key="vendor.id">
                            <button type="button" @click="handleVendorSelect(vendor)" class="w-full text-left p-4 hover:bg-secondary transition-colors border-b border-border last:border-0 group">
                                <div class="font-black text-sm uppercase italic group-hover:text-primary transition-colors" x-text="vendor.name"></div>
                                <div class="text-[10px] text-muted-foreground font-bold uppercase tracking-widest" x-text="`${vendor.companyName} • ${vendor.category.name}`"></div>
                            </button>
                        </template>
                    </div>
                </template>

                <template x-if="selectedVendor">
                    <div class="mt-4 p-4 bg-primary/5 rounded-2xl border border-primary/20 flex items-center justify-between animate-in fade-in slide-in-from-top-2">
                        <div>
                            <div class="text-[10px] font-black uppercase tracking-widest text-primary mb-1">Active Partner</div>
                            <div class="font-black text-foreground uppercase italic" x-text="selectedVendor.companyName"></div>
                        </div>
                        <div class="px-3 py-1 bg-primary text-primary-foreground rounded-lg text-[10px] font-black uppercase tracking-widest" x-text="selectedVendor.category.name"></div>
                    </div>
                </template>
            </div>
        </twig:Card:Content>
    </twig:Card>

    <template x-if="selectedVendor">
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-12 animate-in slide-in-from-bottom-6 duration-700">
            <div class="xl:col-span-2 space-y-8">
                <twig:Card class="bg-card border-border rounded-[3rem] shadow-2xl overflow-hidden border-t-4 border-t-primary/20">
                    <twig:Card:Header class="p-8 border-b border-border bg-secondary/30 flex flex-row items-center justify-between">
                        <twig:Card:Title class="text-xl font-black tracking-tight flex items-center italic text-foreground uppercase">
                            <twig:ux:icon name="lucide:shopping-cart" class="mr-4 h-6 w-6 text-primary" />
                            <span x-text="`Order Items (${draftItems.length})`"></span>
                        </twig:Card:Title>
                        <template x-if="draftItems.length > 0">
                            <twig:Button disabledWhen="submitting" x-on:click="handleSubmitOrder()" class="bg-primary hover:opacity-90 text-primary-foreground font-black text-[10px] tracking-widest h-10 px-6 rounded-xl shadow-lg shadow-primary/20 uppercase">
                                <template x-if="submitting"><span>Submitting...</span></template>
                                <template x-if="!submitting"><span class="contents"><twig:ux:icon name="lucide:send" class="mr-2 h-4 w-4" /> Confirm All Orders</span></template>
                            </twig:Button>
                        </template>
                    </twig:Card:Header>
                    <twig:Card:Content class="p-0">
                        <twig:Table>
                            <twig:Table:Header>
                                <twig:Table:Row class="border-b border-border bg-background/50 hover:bg-transparent">
                                    <twig:Table:Head class="p-6 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground">Product</twig:Table:Head>
                                    <twig:Table:Head class="p-6 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground w-32">Quantity</twig:Table:Head>
                                    <twig:Table:Head class="p-6 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground">Comment</twig:Table:Head>
                                    <twig:Table:Head class="p-6 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground text-right">Action</twig:Table:Head>
                                </twig:Table:Row>
                            </twig:Table:Header>
                            <twig:Table:Body>
                                <template x-if="draftItems.length === 0">
                                    <twig:Table:Row>
                                        <twig:Table:Cell colspan="4" class="p-20 text-center text-muted-foreground font-black uppercase tracking-widest opacity-30 italic">No items added yet</twig:Table:Cell>
                                    </twig:Table:Row>
                                </template>
                                <template x-for="item in draftItems" :key="item.productId">
                                    <twig:Table:Row class="hover:bg-secondary/30 transition-colors group">
                                        <twig:Table:Cell class="p-6">
                                            <span class="font-black text-foreground group-hover:text-primary transition-colors tracking-tighter uppercase italic" x-text="item.productName"></span>
                                        </twig:Table:Cell>
                                        <twig:Table:Cell class="p-6">
                                            <twig:Input type="number" min="1" x-react-value="item.quantity" x-on:input="updateQuantity(item.productId, parseInt($event.target.value) || 1)"
                                                class="h-10 w-24 bg-secondary/50 border-border rounded-xl font-black text-lg text-primary text-center focus:ring-primary/20" />
                                        </twig:Table:Cell>
                                        <twig:Table:Cell class="p-6">
                                            <span class="text-xs text-muted-foreground font-medium" x-text="item.comment || '-'"></span>
                                        </twig:Table:Cell>
                                        <twig:Table:Cell class="p-6 text-right">
                                            <twig:Button variant="ghost" size="icon" x-on:click="removeFromDraft(item.productId)" class="h-10 w-10 text-red-500 hover:bg-red-500/10 rounded-xl">
                                                <twig:ux:icon name="lucide:trash-2" class="h-4 w-4" />
                                            </twig:Button>
                                        </twig:Table:Cell>
                                    </twig:Table:Row>
                                </template>
                            </twig:Table:Body>
                        </twig:Table>
                    </twig:Card:Content>
                </twig:Card>
            </div>

            <div class="space-y-8">
                <twig:Card class="bg-card border-border rounded-[2.5rem] shadow-xl border-t-4 border-t-secondary overflow-hidden sticky top-32">
                    <twig:Card:Header class="p-8 border-b border-border bg-secondary/10">
                        <twig:Card:Title class="text-lg font-black tracking-tight text-foreground uppercase italic flex items-center">
                            <twig:ux:icon name="lucide:plus" class="mr-3 h-5 w-5 text-primary" />
                            Add Selection
                        </twig:Card:Title>
                    </twig:Card:Header>
                    <twig:Card:Content class="p-8 space-y-6">
                        <div x-ref="product" class="space-y-3 relative">
                            <twig:Label class="{{ labelClass }}">Search Product</twig:Label>
                            <div class="relative">
                                <twig:Input placeholder="Type product name..." x-model="productSearch" x-on:focus="onProductFocus()" x-on:input="onProductInput()"
                                    class="bg-secondary/50 border-border rounded-xl h-12 font-bold focus:ring-primary/20 pr-10" />
                                <template x-if="isSearchingProducts">
                                    <div class="absolute right-3 top-1/2 -translate-y-1/2">
                                        <div class="animate-spin h-4 w-4 border-2 border-primary border-t-transparent rounded-full"></div>
                                    </div>
                                </template>
                            </div>
                            <template x-if="showProductSuggestions && products.length > 0">
                                <div class="absolute z-50 left-0 right-0 top-full mt-2 bg-card/95 backdrop-blur-md border border-border rounded-2xl shadow-2xl overflow-hidden max-h-48 overflow-y-auto custom-scrollbar ring-1 ring-black/5">
                                    <template x-for="product in products" :key="product.id">
                                        <button type="button" @click="handleProductSelect(product)" class="w-full text-left p-4 hover:bg-secondary transition-colors border-b border-border last:border-0 group">
                                            <div class="font-black text-[10px] uppercase italic group-hover:text-primary transition-colors" x-text="product.name"></div>
                                            <div class="text-[8px] text-muted-foreground font-bold uppercase tracking-widest" x-text="`Stock: ${product.stock}`"></div>
                                        </button>
                                    </template>
                                </div>
                            </template>
                        </div>

                        <div class="space-y-3">
                            <twig:Label class="{{ labelClass }}">Order Quantity</twig:Label>
                            <twig:Input type="number" min="1" x-react-value="currentQuantity" x-on:input="currentQuantity = parseInt($event.target.value) || 0" class="bg-secondary/50 border-border rounded-xl h-12 font-black text-lg focus:ring-primary/20" />
                        </div>
                        <div class="space-y-3">
                            <twig:Label class="{{ labelClass }}">Notes (Optional)</twig:Label>
                            <twig:Input placeholder="Add specialized instructions..." x-model="currentComment" class="bg-secondary/50 border-border rounded-xl h-12 font-medium focus:ring-primary/20" />
                        </div>
                        <twig:Button x-on:click="addToDraft()" class="w-full bg-foreground text-background hover:bg-primary hover:text-white font-black text-[10px] tracking-widest rounded-xl h-14 uppercase shadow-xl transition-all">Add to Order Flow</twig:Button>
                    </twig:Card:Content>
                </twig:Card>

                <div class="p-8 bg-primary/5 rounded-[2rem] border border-primary/10">
                    <div class="flex items-center mb-4">
                        <twig:ux:icon name="lucide:package" class="h-5 w-5 text-primary mr-3" />
                        <h3 class="font-black text-xs uppercase tracking-widest text-foreground italic">Fulfillment Guide</h3>
                    </div>
                    <p class="text-[10px] text-muted-foreground font-medium leading-relaxed uppercase tracking-wider">Adding items to the draft does not notify the vendor. You must confirm all selections in the order table to trigger the supply request.</p>
                </div>
            </div>
        </div>
    </template>
</div>
{% endblock %}
