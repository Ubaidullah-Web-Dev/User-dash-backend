{# Port of app/(tenant)/[companySlug]/admin/sales-lab/page.tsx #}
{% extends 'admin/layout.html.twig' %}
{% block pages %}admin-sales-lab{% endblock %}
{% set iconClass = 'absolute left-4 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground/50 group-focus-within:text-primary transition-colors' %}
{% set noSpin = '[appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none' %}
{% block content %}
<div x-data="salesLab">
    <template x-if="lastOrderId">
        <div>
            <div class="flex flex-col items-center justify-center min-vh-70 h-[70vh] animate-in zoom-in-95 duration-500">
                <div class="bg-primary/10 h-32 w-32 rounded-full flex items-center justify-center mb-8 border border-primary/20">
                    <twig:ux:icon name="lucide:circle-check-big" class="h-16 w-16 text-primary" />
                </div>
                <h1 class="text-5xl font-black italic uppercase tracking-tighter mb-4">Sale <span class="text-primary">Recorded</span></h1>
                <p class="text-muted-foreground font-black uppercase tracking-widest text-[10px] mb-8" x-text="`Batch Order ID: #${lastOrderId}`"></p>

                <div class="flex bg-secondary/30 p-2 rounded-2xl border border-border items-center gap-3 px-4 h-14 mb-8">
                    <twig:Switch model="showHeader" id="show-header-sales" class="data-[state=checked]:bg-primary" />
                    <twig:Label for="show-header-sales" class="text-[10px] font-black uppercase tracking-widest cursor-pointer opacity-70">Include Branding (Header/Footer)</twig:Label>
                </div>

                <div class="flex flex-row items-center space-x-4">
                    <twig:Button disabledWhen="isPreviewing" x-on:click="lastOrderId && handlePreviewInvoice(lastOrderId)" class="h-14 px-10 rounded-2xl bg-secondary text-foreground font-black uppercase tracking-widest min-w-[200px] hover:bg-secondary/80">
                        <template x-if="isPreviewing"><twig:ux:icon name="lucide:loader-circle" class="mr-3 h-5 w-5 animate-spin" /></template>
                        <template x-if="!isPreviewing"><twig:ux:icon name="lucide:eye" class="mr-3 h-5 w-5" /></template>
                        <span x-text="isPreviewing ? 'Loading...' : 'Preview Invoice'"></span>
                    </twig:Button>
                    <twig:Button disabledWhen="isDownloadingInvoice" x-on:click="lastOrderId && handleDownloadInvoice(lastOrderId)" class="h-14 px-10 rounded-2xl bg-primary text-white font-black uppercase tracking-widest min-w-[200px]">
                        <template x-if="isDownloadingInvoice"><twig:ux:icon name="lucide:loader-circle" class="mr-3 h-5 w-5 animate-spin" /></template>
                        <template x-if="!isDownloadingInvoice"><twig:ux:icon name="lucide:file-down" class="mr-3 h-5 w-5" /></template>
                        <span x-text="isDownloadingInvoice ? 'Generating...' : 'Get Invoice'"></span>
                    </twig:Button>
                    <twig:Button x-on:click="startNewSale()" class="h-14 px-10 rounded-2xl bg-secondary text-foreground font-black uppercase tracking-widest">Next Transaction</twig:Button>
                </div>
            </div>

            <template x-if="previewUrl">
                <div class="fixed inset-0 z-100 flex flex-col bg-background/95 backdrop-blur-sm animate-in fade-in duration-300">
                    <div class="p-4 border-b border-border flex justify-between items-center bg-card shadow-sm">
                        <div>
                            <h2 class="text-xl font-black uppercase italic tracking-tighter text-primary">INVOICE <span class="text-foreground not-italic">Preview</span></h2>
                            <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest mt-1" x-text="`Order #${lastOrderId}`"></p>
                        </div>
                        <div class="flex flex-row items-center space-x-4">
                            <twig:Button x-on:click="downloadPreview()" class="bg-primary hover:bg-primary/90 text-white font-black px-6 rounded-xl flex items-center gap-2 uppercase italic shadow-lg shadow-primary/20 h-10">
                                <twig:ux:icon name="lucide:file-down" class="h-4 w-4" />
                                DOWNLOAD PDF
                            </twig:Button>
                            <div class="w-px h-8 bg-border"></div>
                            <twig:Button variant="ghost" size="icon" x-on:click="closePreview()" class="rounded-full bg-secondary/50 hover:bg-secondary h-10 w-10 shrink-0">
                                <twig:ux:icon name="lucide:x" class="h-5 w-5" />
                            </twig:Button>
                        </div>
                    </div>
                    <div class="flex-1 w-full p-4 md:p-8 bg-secondary/5 overflow-hidden">
                        <iframe :src="previewUrl" class="w-full h-full rounded-2xl shadow-2xl border border-border bg-white"></iframe>
                    </div>
                </div>
            </template>
        </div>
    </template>

    <template x-if="!lastOrderId">
        <div class="h-[calc(100vh+10rem)] flex flex-col md:flex-row space-y-6 md:space-y-0 md:space-x-6 animate-in fade-in duration-500 overflow-hidden px-4 pb-4 -mt-8">
            <div class="flex-1 flex flex-col bg-card border border-border rounded-[2.5rem] shadow-xl overflow-hidden">
                <div class="p-6 border-b border-border bg-secondary/30 flex-none pb-8">
                    <div class="flex items-center gap-3 mb-6">
                        <twig:ux:icon name="lucide:activity" class="h-6 w-6 text-primary" />
                        <h1 class="text-2xl font-black text-foreground tracking-tighter italic uppercase leading-none">Lab <span class="text-primary not-italic">Billing POS</span></h1>
                    </div>
                    <form @submit.prevent="handleSearchSubmit()" class="flex flex-row space-x-2 w-full">
                        <div class="relative flex-1 group">
                            <twig:ux:icon name="lucide:search" class="absolute left-5 top-1/2 -translate-y-1/2 h-5 w-5 text-muted-foreground group-focus-within:text-primary transition-colors" />
                            <twig:Input placeholder="Search reagent or medication..." x-model="search" class="pl-14 bg-background border-border rounded-2xl h-14 font-black focus:ring-primary/20 transition-all shadow-inner" />
                        </div>
                        <div class="w-[180px] shrink-0">
                            <twig:Select model="selectedCategory" options="categoryOptions" placeholder="Category" onChange="currentPage = 1" triggerIcon="funnel" triggerIconClass="h-4 w-4 text-primary" triggerIconWrapClass="flex items-center gap-2"
                                triggerClass="h-14 bg-background border-border rounded-2xl font-black uppercase text-[10px] tracking-widest pl-5 shadow-inner"
                                contentClass="rounded-2xl border-border bg-card shadow-2xl font-black uppercase text-[10px] tracking-widest" />
                        </div>
                        <twig:Button type="submit" class="h-14 w-14 rounded-2xl bg-primary text-primary-foreground shadow-lg shadow-primary/20 shrink-0">
                            <template x-if="loadingProducts"><twig:ux:icon name="lucide:loader-circle" class="h-6 w-6 animate-spin" /></template>
                            <template x-if="!loadingProducts"><twig:ux:icon name="lucide:search" class="h-6 w-6" /></template>
                        </twig:Button>
                    </form>
                </div>

                <div class="flex-1 overflow-y-auto p-6 bg-background/50 custom-scrollbar">
                    <template x-if="loadingProducts">
                        <div class="h-full flex items-center justify-center font-black uppercase text-[10px] tracking-widest italic opacity-50">Syncing with Laboratory Cloud...</div>
                    </template>
                    <template x-if="!loadingProducts">
                        <div class="border border-border bg-card rounded-2xl overflow-hidden shadow-sm mb-20 relative">
                            <twig:Table>
                                <twig:Table:Header class="bg-secondary/30 sticky top-0 z-10 backdrop-blur-md">
                                    <twig:Table:Row class="hover:bg-transparent border-border">
                                        <twig:Table:Head class="font-black uppercase tracking-widest text-[10px]">Reagent Name</twig:Table:Head>
                                        <twig:Table:Head class="font-black uppercase tracking-widest text-[10px]">Company</twig:Table:Head>
                                        <twig:Table:Head class="font-black uppercase tracking-widest text-[10px] text-right">Purchase Price</twig:Table:Head>
                                        <twig:Table:Head class="font-black uppercase tracking-widest text-[10px] text-right">Unit Price</twig:Table:Head>
                                        <twig:Table:Head class="font-black uppercase tracking-widest text-[10px] text-center">Lot/Batch</twig:Table:Head>
                                        <twig:Table:Head class="font-black uppercase tracking-widest text-[10px] text-right">Expiry</twig:Table:Head>
                                        <twig:Table:Head class="font-black uppercase tracking-widest text-[10px] text-right">Stock</twig:Table:Head>
                                        <twig:Table:Head class="w-[100px]"></twig:Table:Head>
                                    </twig:Table:Row>
                                </twig:Table:Header>
                                <twig:Table:Body>
                                    <template x-for="product in products" :key="product.id">
                                        <twig:Table:Row x-on:click="addToCart(product)" class="cursor-pointer transition-colors border-border/50" x-bind:class="product.stock > 0 ? 'hover:bg-primary/5' : 'opacity-40 grayscale'">
                                            <twig:Table:Cell class="p-4 align-middle">
                                                <div class="flex flex-col">
                                                    <span class="font-black text-sm uppercase tracking-tighter text-foreground/90" x-text="product.name"></span>
                                                    <template x-if="product.packSize"><span class="text-[9px] font-bold text-muted-foreground uppercase" x-text="product.packSize"></span></template>
                                                </div>
                                            </twig:Table:Cell>
                                            <twig:Table:Cell class="p-4 align-middle italic text-xs text-muted-foreground" x-text="product.companyName || 'Generic'"></twig:Table:Cell>
                                            <twig:Table:Cell class="p-4 text-right align-middle font-bold text-xs text-muted-foreground" x-text="product.purchasePrice ? `PKR ${Math.round(parseFloat(product.purchasePrice)).toLocaleString()}` : '—'"></twig:Table:Cell>
                                            <twig:Table:Cell class="p-4 text-right align-middle font-black text-primary italic text-sm" x-text="`PKR ${Math.round(parseFloat(product.price)).toLocaleString()}`"></twig:Table:Cell>
                                            <twig:Table:Cell class="p-4 text-center align-middle font-bold text-xs text-foreground/80" x-text="product.batchNumber || '—'"></twig:Table:Cell>
                                            <twig:Table:Cell class="p-4 text-right align-middle">
                                                <div class="flex flex-col items-end">
                                                    <span class="text-[10px] font-bold" :class="isExpired(product) ? 'text-red-500' : 'text-muted-foreground'" x-text="product.expiryDate || '—'"></span>
                                                    <template x-if="isExpired(product)"><twig:ux:icon name="lucide:triangle-alert" class="h-3 w-3 text-red-500 mt-0.5" /></template>
                                                </div>
                                            </twig:Table:Cell>
                                            <twig:Table:Cell class="p-4 text-right align-middle">
                                                <span class="text-[9px] font-black tracking-widest uppercase px-2 py-1 rounded-md inline-block" :class="product.stock > 0 ? 'bg-secondary text-foreground/70' : 'bg-red-500/10 text-red-500'" x-text="product.stock > 0 ? `${product.stock} Units` : 'EMPTY'"></span>
                                            </twig:Table:Cell>
                                            <twig:Table:Cell class="p-4 text-right align-middle">
                                                <twig:Button size="sm" variant="secondary" class="h-8 rounded-lg font-black text-[10px] uppercase tracking-widest bg-primary text-white">Add</twig:Button>
                                            </twig:Table:Cell>
                                        </twig:Table:Row>
                                    </template>
                                </twig:Table:Body>
                            </twig:Table>
                        </div>
                    </template>
                </div>

                <div class="p-4 border-t border-border bg-secondary/20 flex-none flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <twig:Button variant="outline" size="sm" disabledWhen="currentPage === 1 || loadingProducts" x-on:click="currentPage = Math.max(1, currentPage - 1)" class="h-10 px-4 rounded-xl border-border bg-background font-black uppercase text-[10px] tracking-widest hover:bg-primary hover:text-white transition-all disabled:opacity-30">
                            <twig:ux:icon name="lucide:chevron-left" class="h-4 w-4 mr-2" /> Prev
                        </twig:Button>
                        <div class="bg-background border border-border px-4 h-10 rounded-xl flex items-center justify-center font-black text-[10px] tracking-widest text-foreground shadow-inner" x-text="`${currentPage} / ${totalPages}`"></div>
                        <twig:Button variant="outline" size="sm" disabledWhen="currentPage === totalPages || totalPages === 0 || loadingProducts" x-on:click="currentPage = Math.min(totalPages, currentPage + 1)" class="h-10 px-4 rounded-xl border-border bg-background font-black uppercase text-[10px] tracking-widest hover:bg-primary hover:text-white transition-all disabled:opacity-30">
                            Next <twig:ux:icon name="lucide:chevron-right" class="h-4 w-4 ml-2" />
                        </twig:Button>
                    </div>
                    <div class="text-[10px] font-black uppercase tracking-widest text-muted-foreground italic" x-text="`Total Catalog Items: ${totalItems}`"></div>
                </div>
            </div>

            <div class="w-full md:w-[950px] xl:w-[450px] flex-none flex flex-col bg-card border border-border rounded-[2.5rem] shadow-2xl relative overflow-hidden">
                <div class="p-8 border-b border-border bg-linear-to-br from-primary/5 to-transparent flex-none z-10">
                    <h2 class="text-xl font-black tracking-tight flex items-center italic text-foreground uppercase mb-1">
                        <twig:ux:icon name="lucide:shopping-cart" class="mr-3 h-6 w-6 text-primary" />
                        Order Cart
                    </h2>
                    <p class="text-[10px] font-black uppercase text-muted-foreground tracking-widest opacity-50">Local Billing Queue</p>
                </div>

                <div class="flex-[2] min-h-0 overflow-y-auto p-4 bg-secondary/5 custom-scrollbar z-10">
                    <template x-if="cart.length === 0">
                        <div class="h-full flex flex-col items-center justify-center text-center opacity-30 space-y-6">
                            <twig:ux:icon name="lucide:package" class="h-20 w-20 mb-2 text-muted-foreground" />
                            <p class="font-black uppercase tracking-[0.2em] text-[10px] italic">No items drafted</p>
                        </div>
                    </template>
                    <template x-if="cart.length > 0">
                        <div class="space-y-3">
                            <template x-for="item in cart" :key="item.id">
                                <div class="flex flex-col space-y-3 p-4 bg-background border border-border rounded-xl shadow-sm animate-in slide-in-from-right-2 duration-300">
                                    <div class="flex justify-between items-start">
                                        <div class="w-3/4">
                                            <h4 class="font-black uppercase text-[12px] tracking-tighter leading-none" x-text="item.name"></h4>
                                            <template x-if="item.companyName"><span class="text-[9px] font-bold text-muted-foreground italic uppercase" x-text="item.companyName"></span></template>
                                        </div>
                                        <span class="font-black italic text-primary text-sm" x-text="`PKR ${Math.round(parseFloat(item.price) * item.cartQuantity).toLocaleString()}`"></span>
                                    </div>
                                    <div class="flex items-center justify-between pt-2 border-t border-border/50">
                                        <div class="flex flex-row items-center space-x-1 bg-secondary rounded-lg p-0.5 border border-border">
                                            <twig:Button variant="ghost" size="sm" x-on:click="updateQuantity(item.id, -1)" class="h-7 w-7 p-0 rounded hover:bg-background"><twig:ux:icon name="lucide:minus" class="h-3 w-3" /></twig:Button>
                                            <input type="number" x-react-value="item.cartQuantity || ''" @input="handleManualQuantityChange(item.id, $event.target.value)"
                                                   @blur="if (item.cartQuantity < 1) handleManualQuantityChange(item.id, '1')"
                                                   class="font-black text-xs w-8 text-center bg-transparent border-none focus:outline-hidden {{ noSpin }}" />
                                            <twig:Button variant="ghost" size="sm" x-on:click="updateQuantity(item.id, 1)" class="h-7 w-7 p-0 rounded hover:bg-background"><twig:ux:icon name="lucide:plus" class="h-3 w-3" /></twig:Button>
                                        </div>
                                        <div class="flex items-center gap-1 bg-secondary px-2 py-1 rounded-lg border border-border">
                                            <twig:Button variant="ghost" size="sm" x-on:click="toggleDiscountType(item)" class="h-6 w-6 p-0 rounded hover:bg-background text-primary">
                                                <template x-if="item.discountType === 'percent'"><twig:ux:icon name="lucide:percent" class="h-3 w-3" /></template>
                                                <template x-if="item.discountType !== 'percent'"><span class="text-[10px] font-bold">PKR</span></template>
                                            </twig:Button>
                                            <input type="number" x-react-value="item.discountType === 'percent' ? item.discountPercentage : item.discountAmount"
                                                   @input="updateDiscount(item.id, parseFloat($event.target.value) || 0, item.discountType)"
                                                   class="w-12 bg-transparent font-black text-[10px] focus:outline-hidden {{ noSpin }}" placeholder="0" />
                                            <span class="text-[8px] font-bold opacity-30" x-text="item.discountType === 'percent' ? '%' : ''"></span>
                                        </div>
                                        <template x-if="item.discountPercentage > 0 || item.discountAmount > 0">
                                            <div class="flex flex-col items-end mr-3">
                                                <span class="text-[13px] font-black text-primary uppercase italic" x-text="`-PKR ${itemSavings(item).toLocaleString()}`"></span>
                                                <span class="text-[10px] font-black text-muted-foreground/80 uppercase tracking-tighter leading-none">Savings</span>
                                            </div>
                                        </template>
                                        <twig:Button variant="ghost" size="sm" x-on:click="removeFromCart(item.id)" class="h-8 w-8 p-0 rounded-lg text-red-500 hover:bg-red-500 hover:text-white transition-colors"><twig:ux:icon name="lucide:trash-2" class="h-4 w-4" /></twig:Button>
                                    </div>
                                </div>
                            </template>
                        </div>
                    </template>
                </div>

                <div class="flex-[3] min-h-0 p-6 border-t border-border bg-background z-10 overflow-y-auto custom-scrollbar">
                    <div class="space-y-3 mb-6">
                        <div class="relative group">
                            <twig:ux:icon name="lucide:circle-user" class="{{ iconClass }} z-20" />
                            <twig:Input placeholder="Patient / Customer Name" x-react-value="customerName" x-on:input="handleCustomerSearch($event.target.value)"
                                x-on:focus="searchSource = 'name'; customerName.length >= 2 && (showSearchDropdown = true)"
                                class="pl-11 bg-secondary/30 border-border rounded-xl h-11 font-bold text-base transition-all" x-bind:class="selectedCustomerId ? 'border-primary shadow-[0_0_0_1px_rgba(var(--primary),0.2)]' : ''" />
                            <template x-if="isSearchingCustomer && searchSource === 'name'">
                                <div class="absolute right-4 top-1/2 -translate-y-1/2 z-20"><twig:ux:icon name="lucide:loader-circle" class="h-3 w-3 animate-spin text-primary" /></div>
                            </template>
                            {{ include('admin/_sales_customer_dropdown.html.twig', {source: 'name'}) }}
                        </div>

                        <div class="relative group">
                            <twig:ux:icon name="lucide:phone" class="{{ iconClass }} z-20" />
                            <twig:Input placeholder="Phone Number" x-react-value="customerPhone" x-on:input="handlePhoneSearch($event.target.value)"
                                x-on:focus="searchSource = 'phone'; customerPhone.length >= 3 && (showSearchDropdown = true)"
                                class="pl-11 bg-secondary/30 border-border rounded-xl h-11 font-bold text-base transition-all" x-bind:class="selectedCustomerId ? 'border-primary shadow-[0_0_0_1px_rgba(var(--primary),0.2)]' : ''" />
                            <template x-if="isSearchingCustomer && searchSource === 'phone'">
                                <div class="absolute right-4 top-1/2 -translate-y-1/2 z-20"><twig:ux:icon name="lucide:loader-circle" class="h-3 w-3 animate-spin text-primary" /></div>
                            </template>
                            {{ include('admin/_sales_customer_dropdown.html.twig', {source: 'phone'}) }}
                        </div>

                        <div class="relative group">
                            <twig:ux:icon name="lucide:building" class="{{ iconClass }}" />
                            <twig:Input placeholder="Referral Hospital / Lab" x-model="labName" x-on:input="unlinkCustomer()" class="pl-11 bg-secondary/30 border-border rounded-xl h-11 font-bold text-base" />
                        </div>
                        <div class="relative group">
                            <twig:ux:icon name="lucide:wallet" class="{{ iconClass }}" />
                            <twig:Input type="number" placeholder="Amount Received" x-model="amountGiven" min="0" class="pl-11 bg-secondary/30 border-border rounded-xl h-11 font-bold text-base {{ noSpin }}" />
                        </div>
                        <div class="relative group">
                            <twig:ux:icon name="lucide:monitor-play" class="{{ iconClass }}" />
                            <twig:Input placeholder="Order Remarks (Optional)" x-model="remarks" class="pl-11 bg-secondary/30 border-border rounded-xl h-11 font-bold text-base" />
                        </div>

                        <template x-if="selectedCustomerId">
                            <div class="space-y-1.5 animate-in slide-in-from-top-2 duration-300">
                                <template x-if="selectedCustomerData">
                                    <div class="flex justify-between items-center px-1">
                                        <span class="text-[10px] font-black uppercase tracking-widest text-primary/60">Balance Payment</span>
                                        <span class="text-[10px] font-black uppercase tracking-widest text-primary" x-text="`Current Bal: PKR ${selectedCustomerData.remainingBalance.toLocaleString()}`"></span>
                                    </div>
                                </template>
                                <div class="relative group">
                                    <twig:ux:icon name="lucide:plus" class="absolute left-4 top-1/2 -translate-y-1/2 h-4 w-4 text-primary transition-colors" />
                                    <twig:Input type="number" placeholder="Add to Previous Balance Payment" x-model="previousBalancePayment" min="0"
                                        class="pl-11 bg-primary/10 border-primary/20 rounded-xl h-11 font-bold text-base text-primary placeholder:text-primary/40 {{ noSpin }}" />
                                </div>
                            </div>
                        </template>
                    </div>

                    <div class="flex flex-col space-y-2 mb-6 px-2">
                        <div class="flex items-end justify-between">
                            <span class="text-[10px] font-black uppercase tracking-widest text-muted-foreground opacity-50">Subtotal</span>
                            <span class="text-xl font-black italic text-foreground tracking-tighter leading-none" x-text="`PKR ${subtotal.toLocaleString()}`"></span>
                        </div>
                        <template x-if="totalDiscountAmount > 0">
                            <div class="flex items-end justify-between">
                                <span class="text-[10px] font-black uppercase tracking-widest text-primary/60">Total Discount</span>
                                <span class="text-xl font-black italic text-primary tracking-tighter leading-none" x-text="`-PKR ${totalDiscountAmount.toLocaleString()}`"></span>
                            </div>
                        </template>
                        <div class="flex items-end justify-between pt-2 border-t border-border/50">
                            <span class="text-[10px] font-black uppercase tracking-widest text-muted-foreground opacity-50">Grand Total</span>
                            <span class="text-3xl font-black italic text-foreground tracking-tighter leading-none" x-text="`PKR ${grandTotal.toLocaleString()}`"></span>
                        </div>
                        <div class="flex items-end justify-between pt-2 border-t border-border/50">
                            <span class="text-[10px] font-black uppercase tracking-widest text-muted-foreground/80">Change Due</span>
                            <span class="text-xl font-black italic tracking-tighter leading-none" :class="changeDue > 0 ? 'text-primary' : 'text-muted-foreground/50'" x-text="`PKR ${Math.abs(changeDue).toLocaleString()}`"></span>
                        </div>
                    </div>

                    <twig:Button x-on:click="handleCheckout()" disabledWhen="isProcessing || cart.length === 0" class="w-full h-14 rounded-2xl bg-primary hover:opacity-90 text-white font-black uppercase tracking-widest text-xs shadow-xl shadow-primary/20">
                        <template x-if="isProcessing"><twig:ux:icon name="lucide:loader-circle" class="h-5 w-5 animate-spin mr-3" /></template>
                        <template x-if="!isProcessing"><twig:ux:icon name="lucide:receipt" class="h-5 w-5 mr-3" /></template>
                        EXECUTE TRANSACTION
                    </twig:Button>
                </div>
            </div>
        </div>
    </template>
</div>
{% endblock %}
