{# The "Registered Clients" dropdown from sales-lab/page.tsx (rendered for source 'name' and 'phone') #}
<template x-if="showSearchDropdown && searchSource === '{{ source }}' && customerSearchResults.length > 0">
    <div class="absolute left-0 right-0 top-full mt-2 bg-popover border border-border rounded-xl shadow-2xl z-50 overflow-hidden animate-in fade-in slide-in-from-top-2 duration-200">
        <div class="p-2 border-b border-border bg-secondary/20 flex justify-between items-center">
            <span class="text-[9px] font-black uppercase tracking-widest text-muted-foreground ml-2">Registered Clients</span>
            <twig:Button variant="ghost" size="sm" class="h-5 w-5 p-0 rounded-full" x-on:click="showSearchDropdown = false"><twig:ux:icon name="lucide:minus" class="h-3 w-3" /></twig:Button>
        </div>
        <div class="max-h-[200px] overflow-y-auto custom-scrollbar">
            <template x-for="customer in customerSearchResults" :key="customer.id">
                <div @click="selectCustomer(customer)" class="p-3 hover:bg-primary/10 cursor-pointer border-b border-border/50 last:border-0 transition-colors flex items-center justify-between group">
                    <div>
                        <p class="font-black text-xs uppercase tracking-tighter group-hover:text-primary transition-colors" x-text="customer.name"></p>
                        <p class="text-[9px] font-bold text-muted-foreground uppercase" x-text="`${customer.phone} ${customer.labName ? `• ${customer.labName}` : ''}`"></p>
                    </div>
                    <div class="h-6 w-6 rounded-lg bg-secondary flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                        <twig:ux:icon name="lucide:plus" class="h-3.5 w-3.5 text-primary" />
                    </div>
                </div>
            </template>
        </div>
    </div>
</template>
