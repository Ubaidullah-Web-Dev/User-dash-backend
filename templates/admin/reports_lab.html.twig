{# Port of app/(tenant)/[companySlug]/admin/reports-lab/page.tsx #}
{% extends 'admin/layout.html.twig' %}
{% block pages %}admin-reports-lab{% endblock %}
{% block content %}
<div x-data="reportsLab">
    <template x-if="loading">
        <div class="py-20 text-center font-black animate-pulse text-primary tracking-widest uppercase italic">Compiling Intelligence Matrix...</div>
    </template>
    <template x-if="!loading">
        <div class="space-y-6 animate-in fade-in duration-700">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div>
                    <h1 class="text-4xl font-black text-foreground tracking-tighter mb-2 uppercase italic">LAB <span class="text-primary not-italic">Intelligence</span></h1>
                    <p class="text-muted-foreground font-medium uppercase text-[10px] tracking-widest leading-relaxed">Statistical Analysis &amp; Financial Audits <br /><span x-text="`Generated at ${generatedAt}`"></span></p>
                </div>
                <div class="flex bg-secondary/30 p-4 rounded-2xl border border-border items-center gap-4">
                    <div class="flex flex-col">
                        <twig:Label class="text-[10px] font-black uppercase tracking-widest text-foreground">Header &amp; Footer</twig:Label>
                        <p class="text-[9px] text-muted-foreground font-medium uppercase tracking-tighter">Include branding in Intelligence PDFs</p>
                    </div>
                    <twig:Switch model="showHeader" class="data-[state=checked]:bg-primary" />
                </div>
            </div>

            <twig:Spotlight class="border border-border/40 bg-secondary/5 rounded-2xl p-6 overflow-hidden">
                <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
                    <div class="flex flex-col sm:flex-row items-center gap-6 w-full lg:w-auto">
                        <div class="flex items-center gap-4 w-full sm:w-auto">
                            <div class="w-12 h-12 rounded-2xl bg-indigo-500/10 flex items-center justify-center text-indigo-500 shrink-0">
                                {{ ux_icon('lucide:calendar', {width: 20, height: 20}) }}
                            </div>
                            <div class="flex flex-col gap-1 w-full sm:w-auto">
                                <twig:Label class="text-[10px] font-black uppercase tracking-widest text-muted-foreground ml-1">Range Initiation</twig:Label>
                                <input type="date" x-model="startDate" class="bg-background/50 border border-border/40 rounded-xl px-4 py-2 text-sm font-bold uppercase tracking-tight focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all w-full" />
                            </div>
                        </div>
                        <div class="hidden sm:block text-muted-foreground/30 font-black">
                            {{ ux_icon('lucide:chevron-down', {width: 20, height: 20, class: '-rotate-90'}) }}
                        </div>
                        <div class="flex items-center gap-4 w-full sm:w-auto">
                            <div class="w-12 h-12 rounded-2xl bg-pink-500/10 flex items-center justify-center text-pink-500 shrink-0">
                                {{ ux_icon('lucide:activity', {width: 20, height: 20}) }}
                            </div>
                            <div class="flex flex-col gap-1 w-full sm:w-auto">
                                <twig:Label class="text-[10px] font-black uppercase tracking-widest text-muted-foreground ml-1">Range Termination</twig:Label>
                                <input type="date" x-model="endDate" class="bg-background/50 border border-border/40 rounded-xl px-4 py-2 text-sm font-bold uppercase tracking-tight focus:outline-none focus:ring-2 focus:ring-pink-500/20 transition-all w-full" />
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 w-full lg:w-auto pt-4 lg:pt-0 border-t lg:border-t-0 border-border/40">
                        <twig:Magnetic>
                            <twig:Button variant="outline" x-on:click="previewSummary('custom')" disabledWhen="previewing" class="flex-1 lg:flex-none rounded-xl border-border/40 hover:bg-background h-12 px-8 font-black uppercase text-[12px] tracking-widest gap-2">
                                <template x-if="previewing"><twig:ux:icon name="lucide:loader-circle" class="h-5 w-5 animate-spin text-indigo-500" /></template>
                                <template x-if="!previewing"><twig:ux:icon name="lucide:eye" class="h-5 w-5 text-indigo-500" /></template>
                                PREVIEW AUDIT
                            </twig:Button>
                        </twig:Magnetic>
                        <twig:Magnetic>
                            <twig:Button x-on:click="downloadSummary('custom')" class="flex-1 lg:flex-none rounded-xl bg-indigo-500 hover:bg-indigo-600 text-white h-12 px-8 font-black uppercase text-[12px] tracking-widest gap-2 shadow-lg shadow-indigo-500/20 transition-all active:scale-95">
                                <twig:ux:icon name="lucide:download" class="h-5 w-5" />
                                EXPORT PDF
                            </twig:Button>
                        </twig:Magnetic>
                    </div>
                </div>
            </twig:Spotlight>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
                <twig:Card class="bg-card border-border rounded-3xl shadow-sm overflow-hidden border-t-4 border-t-indigo-500/20">
                    <twig:Card:Header class="p-6 border-b border-border bg-secondary/5 flex flex-row items-center justify-between">
                        <div>
                            <twig:Card:Title class="text-xl font-black flex items-center gap-3 uppercase">
                                <twig:ux:icon name="lucide:shopping-bag" class="h-6 w-6 text-indigo-500" />
                                Sales Velocity
                            </twig:Card:Title>
                            <twig:Card:Description class="text-[10px] font-black uppercase tracking-widest">Revenue tracking for the last 30 intervals.</twig:Card:Description>
                        </div>
                    </twig:Card:Header>
                    <twig:Card:Content class="p-0">
                        <twig:Table>
                            <twig:Table:Header>
                                <twig:Table:Row class="border-border hover:bg-transparent">
                                    <twig:Table:Head class="p-6 font-black uppercase text-[10px] tracking-widest">Date Node</twig:Table:Head>
                                    <twig:Table:Head class="p-6 font-black uppercase text-[10px] tracking-widest text-right">Pending</twig:Table:Head>
                                    <twig:Table:Head class="p-6 font-black uppercase text-[10px] tracking-widest text-right">Volume (PKR)</twig:Table:Head>
                                </twig:Table:Row>
                            </twig:Table:Header>
                            <twig:Table:Body>
                                <template x-for="(sale, i) in (data?.dailySales || [])" :key="i">
                                    <twig:Table:Row class="border-border hover:bg-secondary/5 group">
                                        <twig:Table:Cell class="p-6 font-bold text-muted-foreground" x-text="sale.date"></twig:Table:Cell>
                                        <twig:Table:Cell class="p-6 text-right font-black text-pink-500/40 group-hover:text-pink-500 transition-colors italic" x-text="`PKR ${Math.round(sale.pending || 0).toLocaleString()}`"></twig:Table:Cell>
                                        <twig:Table:Cell class="p-6 text-right font-black text-indigo-500 italic">
                                            <div class="flex items-center justify-end gap-2">
                                                <span x-text="`PKR ${Math.round(sale.total).toLocaleString()}`"></span>
                                                <div class="flex bg-secondary/30 rounded-lg p-0.5 opacity-0 group-hover:opacity-100 transition-opacity ml-4">
                                                    <twig:Button variant="ghost" size="icon" x-on:click="previewSummary('daily', sale.date)" title="Preview Daily" disabledWhen="previewing" class="h-8 w-8 text-muted-foreground hover:text-indigo-500 hover:bg-background rounded-md transition-all">
                                                        <template x-if="previewing"><twig:ux:icon name="lucide:loader-circle" class="h-4 w-4 animate-spin" /></template>
                                                        <template x-if="!previewing"><twig:ux:icon name="lucide:eye" class="h-4 w-4" /></template>
                                                    </twig:Button>
                                                    <twig:Button variant="ghost" size="icon" x-on:click="downloadSummary('daily', sale.date)" title="Download Daily" class="h-8 w-8 text-muted-foreground hover:text-indigo-500 hover:bg-background rounded-md transition-all">
                                                        <twig:ux:icon name="lucide:download" class="h-4 w-4" />
                                                    </twig:Button>
                                                </div>
                                            </div>
                                        </twig:Table:Cell>
                                    </twig:Table:Row>
                                </template>
                                <template x-if="!data?.dailySales || data.dailySales.length === 0">
                                    <twig:Table:Row>
                                        <twig:Table:Cell colspan="3" class="p-20 text-center italic opacity-30 font-medium font-black uppercase text-[10px] tracking-widest">No transaction history detected</twig:Table:Cell>
                                    </twig:Table:Row>
                                </template>
                            </twig:Table:Body>
                        </twig:Table>
                    </twig:Card:Content>
                </twig:Card>

                <twig:Card class="bg-card border-border rounded-3xl shadow-sm overflow-hidden border-t-4 border-t-red-500/20">
                    <twig:Card:Header class="p-6 border-b border-border bg-secondary/5 flex flex-row items-center justify-between">
                        <div>
                            <twig:Card:Title class="text-xl font-black flex items-center gap-3 uppercase">
                                <twig:ux:icon name="lucide:circle-alert" class="h-6 w-6 text-red-500" />
                                Critical Replenish
                            </twig:Card:Title>
                            <twig:Card:Description class="text-[10px] font-black uppercase tracking-widest">Items currently below minimum operating thresholds.</twig:Card:Description>
                        </div>
                    </twig:Card:Header>
                    <twig:Card:Content class="p-0">
                        <twig:Table>
                            <twig:Table:Header>
                                <twig:Table:Row class="border-border hover:bg-transparent">
                                    <twig:Table:Head class="p-6 font-black uppercase text-[10px] tracking-widest">Entity</twig:Table:Head>
                                    <twig:Table:Head class="p-6 font-black uppercase text-[10px] tracking-widest text-center">Remaining</twig:Table:Head>
                                    <twig:Table:Head class="p-6 font-black uppercase text-[10px] tracking-widest text-center">Status</twig:Table:Head>
                                </twig:Table:Row>
                            </twig:Table:Header>
                            <twig:Table:Body>
                                <template x-for="item in (data?.lowStock || [])" :key="item.id">
                                    <twig:Table:Row class="border-border hover:bg-red-500/5">
                                        <twig:Table:Cell class="p-6">
                                            <div class="flex flex-col">
                                                <span class="font-bold text-foreground" x-text="item.name"></span>
                                                <span class="text-[10px] font-black uppercase text-muted-foreground italic" x-text="item.companyName || 'Unknown Origin'"></span>
                                            </div>
                                        </twig:Table:Cell>
                                        <twig:Table:Cell class="p-6 text-center font-black text-red-500" x-text="`${item.stock} / ${item.minimumStock}`"></twig:Table:Cell>
                                        <twig:Table:Cell class="p-6 text-center">
                                            <span class="px-3 py-1 bg-red-500/10 text-red-500 border border-red-500/20 rounded-full text-[9px] font-black uppercase animate-pulse">REFILL</span>
                                        </twig:Table:Cell>
                                    </twig:Table:Row>
                                </template>
                                <template x-if="!data?.lowStock || data.lowStock.length === 0">
                                    <twig:Table:Row>
                                        <twig:Table:Cell colspan="3" class="p-20 text-center italic opacity-30 font-medium font-black uppercase text-[10px] tracking-widest">All inventory channels optimized</twig:Table:Cell>
                                    </twig:Table:Row>
                                </template>
                            </twig:Table:Body>
                        </twig:Table>
                    </twig:Card:Content>
                </twig:Card>
            </div>

            {{ include('admin/_pdf_preview.html.twig', {
                titleHtml: 'INTELLIGENCE <span class="text-foreground not-italic">Preview</span>', titleClass: 'text-indigo-500/80',
                subtitle: 'Reviewing statistical summary', iconName: 'download',
                buttonClass: 'bg-indigo-500 hover:bg-indigo-600 text-white font-black px-6 rounded-xl flex items-center gap-2 uppercase italic shadow-lg shadow-indigo-500/20 h-10',
            }) }}
        </div>
    </template>
</div>
{% endblock %}
