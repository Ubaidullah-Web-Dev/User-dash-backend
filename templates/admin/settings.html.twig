{# Port of app/(tenant)/[companySlug]/admin/settings/page.tsx #}
{% extends 'admin/layout.html.twig' %}
{% block pages %}admin-settings{% endblock %}
{% block content %}
<div class="space-y-10 animate-in fade-in slide-in-from-bottom-4 duration-700" x-data="adminSettings">
    <div>
        <h1 class="text-4xl font-black text-foreground tracking-tighter mb-2 italic uppercase">SYSTEM <span class="text-primary not-italic">Settings</span></h1>
        <p class="text-muted-foreground font-medium uppercase text-[10px] tracking-widest leading-loose">Global Environment Control &amp; System Optimization.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <twig:Card class="bg-card border-border rounded-[2.5rem] shadow-xl border-t-4 border-t-primary/20 overflow-hidden group hover:border-primary/40 transition-all">
            <twig:Card:Header class="p-8 border-b border-border bg-secondary/10">
                <twig:Card:Title class="text-lg font-black tracking-tight text-foreground uppercase italic flex items-center">
                    <twig:ux:icon name="lucide:globe" class="mr-3 h-5 w-5 text-primary" />
                    General Parameters
                </twig:Card:Title>
                <twig:Card:Description class="text-[10px] font-black uppercase tracking-widest mt-1 opacity-50">Regional and display configurations.</twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content class="p-8">
                <div class="flex flex-col items-center justify-center py-10 text-center space-y-4">
                    <twig:ux:icon name="lucide:zap" class="h-10 w-10 text-primary opacity-20 animate-pulse" />
                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground italic">System modules initializing...</p>
                </div>
            </twig:Card:Content>
        </twig:Card>

        <twig:Card class="bg-card border-border rounded-[2.5rem] shadow-xl border-t-4 border-t-secondary overflow-hidden group hover:border-secondary/40 transition-all">
            <twig:Card:Header class="p-8 border-b border-border bg-secondary/10">
                <twig:Card:Title class="text-lg font-black tracking-tight text-foreground uppercase italic flex items-center">
                    <twig:ux:icon name="lucide:bell" class="mr-3 h-5 w-5 text-secondary" />
                    Notifications Flow
                </twig:Card:Title>
                <twig:Card:Description class="text-[10px] font-black uppercase tracking-widest mt-1 opacity-50">Critical alert &amp; dispatch settings.</twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content class="p-8">
                <div class="flex flex-col items-center justify-center py-10 text-center space-y-4">
                    <twig:ux:icon name="lucide:settings" class="h-10 w-10 text-secondary opacity-20 animate-spin-slow" />
                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground italic">Awaiting protocol deployment...</p>
                </div>
            </twig:Card:Content>
        </twig:Card>

        <twig:Card class="bg-card border-border rounded-[2.5rem] shadow-xl border-t-4 border-t-emerald-500/20 overflow-hidden group hover:border-emerald-500/40 transition-all md:col-span-2 lg:col-span-2 xl:col-span-1">
            <twig:Card:Header class="p-8 border-b border-border bg-secondary/10">
                <twig:Card:Title class="text-lg font-black tracking-tight text-foreground uppercase italic flex items-center">
                    <twig:ux:icon name="lucide:database" class="mr-3 h-5 w-5 text-emerald-500" />
                    Database Management
                </twig:Card:Title>
                <twig:Card:Description class="text-[10px] font-black uppercase tracking-widest mt-1 opacity-50">Secure backups &amp; data integrity.</twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content class="p-8">
                <div class="flex flex-col items-center justify-center py-6 text-center space-y-4">
                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground italic mb-2">Download a full snapshot of the working database.</p>
                    <twig:Button x-on:click="handleBackup()" disabledWhen="isBackingUp"
                        class="w-full sm:w-auto rounded-xl h-12 px-8 font-bold uppercase tracking-widest text-[10px] bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500 hover:text-white border border-emerald-500/20 transition-all shadow-lg shadow-emerald-500/10 flex items-center gap-2">
                        <template x-if="isBackingUp"><span class="contents"><twig:ux:icon name="lucide:loader-circle" class="h-4 w-4 animate-spin" /> Generating...</span></template>
                        <template x-if="!isBackingUp"><span class="contents"><twig:ux:icon name="lucide:download" class="h-4 w-4" /> Download SQL Backup</span></template>
                    </twig:Button>
                </div>
            </twig:Card:Content>
        </twig:Card>
    </div>

    <div class="p-10 bg-primary/5 rounded-[3rem] border border-primary/10 flex items-center justify-between">
        <div class="flex items-center space-x-6">
            <div class="h-14 w-14 rounded-2xl bg-primary/10 flex items-center justify-center border border-primary/20">
                <twig:ux:icon name="lucide:shield-check" class="h-8 w-8 text-primary" />
            </div>
            <div>
                <h3 class="font-black text-xs uppercase tracking-widest text-foreground italic">Access Management Note</h3>
                <p class="text-[10px] text-muted-foreground font-medium leading-relaxed uppercase tracking-wider mt-1 max-w-md">
                    User role elevation and permission scrubbing has been relocated to the <span class="text-primary font-black">User Identity</span> directory for unified management.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
