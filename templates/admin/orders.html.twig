{# Port of app/(tenant)/[companySlug]/admin/orders/page.tsx #}
{% extends 'admin/layout.html.twig' %}
{% block pages %}admin-orders{% endblock %}
{% set labelClass = 'text-[10px] font-black uppercase tracking-widest text-muted-foreground' %}
{% set inputClass = 'pl-9 bg-secondary/50 border-border rounded-xl h-10 font-bold focus:ring-primary/20' %}
{% block content %}
<div x-data="ordersPage">
    <template x-if="loading && orders.length === 0">
        <div class="py-20 text-center font-black animate-pulse text-primary tracking-widest uppercase">Fetching Global Supply Chain...</div>
    </template>
    <template x-if="!(loading && orders.length === 0)">
        <div class="space-y-6 animate-in fade-in duration-700">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-6">
                <div>
                    <h1 class="text-4xl font-black text-foreground tracking-tighter mb-2 italic uppercase">SUPPLY <span class="text-primary not-italic">Orders</span></h1>
                    <p class="text-muted-foreground font-medium uppercase text-[10px] tracking-widest leading-loose">Track and manage inventory restock requests from all vendors.</p>
                </div>
                <div class="flex flex-col md:flex-row items-center gap-4">
                    <a href="/{{ companySlug }}/admin/orders/new">
                        <twig:Button class="bg-primary hover:opacity-90 text-primary-foreground font-black text-[10px] tracking-widest h-11 px-8 rounded-xl shadow-lg shadow-primary/20 uppercase">
                            <twig:ux:icon name="lucide:plus" class="mr-2 h-4 w-4" /> Create New Order
                        </twig:Button>
                    </a>
                </div>
            </div>

            <div class="bg-card border border-border rounded-2xl overflow-hidden shadow-sm shadow-black/5 w-full">
                <div class="px-6 py-4 bg-secondary/20 flex items-center justify-between border-b border-border">
                    <div class="flex items-center text-foreground font-black tracking-widest uppercase text-xs italic">
                        <twig:ux:icon name="lucide:funnel" class="mr-3 h-4 w-4 text-primary" />
                        Search &amp; Filters
                    </div>
                </div>
                <div class="p-6 bg-card/50 space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                        {% for f in [
                            {label: 'Product Name', model: 'productName', placeholder: 'Search by name...'},
                            {label: 'Order ID', model: 'orderId', placeholder: 'Order ID...'},
                            {label: 'Category', model: 'category', placeholder: 'Category Name or ID...'},
                            {label: 'Product ID', model: 'productId', placeholder: 'Exact Product ID...'},
                        ] %}
                            <div class="space-y-2">
                                <twig:Label class="{{ labelClass }}">{{ f.label }}</twig:Label>
                                <div class="relative">
                                    <twig:ux:icon name="lucide:search" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
                                    <twig:Input placeholder="{{ f.placeholder }}" x-model="{{ f.model }}" class="{{ inputClass }}" />
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="pt-4 border-t border-border flex flex-wrap items-center gap-3">
                        <span class="text-[10px] font-black uppercase tracking-widest text-muted-foreground mr-2">Status:</span>
                        <template x-for="s in statuses" :key="s">
                            <button type="button" @click="filter = s" x-text="s || 'ALL'"
                                    class="px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border transition-all"
                                    :class="filter === s ? 'bg-primary text-primary-foreground border-primary shadow-lg shadow-primary/20' : 'bg-card text-muted-foreground border-border hover:border-primary/50'"></button>
                        </template>
                    </div>

                    <div class="pt-4 border-t border-border flex justify-end gap-3">
                        <twig:Button x-on:click="handleClearFilters()" variant="outline" class="hover:bg-destructive/10 hover:text-destructive hover:border-destructive/30 font-black text-[10px] tracking-widest h-11 px-8 rounded-xl uppercase transition-colors">Clear Filters</twig:Button>
                        <twig:Button x-on:click="handleApplyFilters()" class="bg-primary hover:opacity-90 text-primary-foreground font-black text-[10px] tracking-widest h-11 px-8 rounded-xl shadow-lg shadow-primary/20 uppercase">
                            <twig:ux:icon name="lucide:search" class="mr-2 h-4 w-4" /> Apply Filters
                        </twig:Button>
                    </div>
                </div>
            </div>

            <twig:Card class="bg-card border-border rounded-[3rem] shadow-2xl overflow-hidden border-t-4 border-t-primary/20">
                <twig:Card:Header class="p-10 border-b border-border bg-secondary/30">
                    <twig:Card:Title class="text-xl font-black tracking-tight flex items-center italic text-foreground uppercase">
                        <twig:ux:icon name="lucide:shopping-bag" class="mr-4 h-6 w-6 text-primary" />
                        <span x-text="`GLOBAL REQUEST LIST (${orders.length})`"></span>
                    </twig:Card:Title>
                </twig:Card:Header>
                <twig:Card:Content class="p-0">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead>
                                <tr class="border-b border-border bg-background/50">
                                    <th class="p-6 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground">ID &amp; Date</th>
                                    <th class="p-6 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground">Supplier / Product</th>
                                    <th class="p-6 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground">Qty</th>
                                    <th class="p-6 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground">Status</th>
                                    <th class="p-6 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground text-right">Update Flow</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border">
                                <template x-if="orders.length === 0">
                                    <tr><td colspan="5" class="p-20 text-center text-muted-foreground font-black uppercase tracking-widest opacity-50 italic">No orders found matching the criteria</td></tr>
                                </template>
                                <template x-for="o in orders" :key="o.id">
                                    <tr class="hover:bg-secondary/50 transition-colors group">
                                        <td class="p-6">
                                            <div class="flex flex-col">
                                                <span class="font-black text-foreground group-hover:text-primary transition-colors tracking-tighter" x-text="`#SUP-${o.id}`"></span>
                                                <span class="text-[10px] text-muted-foreground font-bold" x-text="new Date(o.createdAt).toLocaleDateString()"></span>
                                            </div>
                                        </td>
                                        <td class="p-6">
                                            <div class="flex flex-col">
                                                <span class="font-bold text-foreground flex items-center">
                                                    <span x-text="o.vendorName"></span>
                                                    <twig:ux:icon name="lucide:arrow-up-right" class="ml-1.5 h-3 w-3 text-muted-foreground group-hover:text-primary" />
                                                </span>
                                                <span class="text-xs text-muted-foreground uppercase font-black tracking-widest flex items-center">
                                                    <twig:ux:icon name="lucide:package" class="mr-1.5 h-3 w-3" /> <span class="text-primary/70 mr-1" x-text="`[ID: ${o.productId}]`"></span> <span x-text="o.productName"></span>
                                                </span>
                                            </div>
                                        </td>
                                        <td class="p-6">
                                            <span class="font-black text-foreground text-lg tracking-tighter" x-text="o.quantity.toLocaleString()"></span><span class="text-[10px] text-muted-foreground ml-1.5 font-bold uppercase">Units</span>
                                        </td>
                                        <td class="p-6">
                                            <div class="inline-flex items-center px-4 py-1.5 rounded-full border text-[10px] font-black uppercase tracking-widest space-x-2" :class="getStatusColor(o.status)">
                                                <template x-if="o.status === 'pending'"><twig:ux:icon name="lucide:clock" class="h-4 w-4" /></template>
                                                <template x-if="o.status === 'approved'"><twig:ux:icon name="lucide:truck" class="h-4 w-4" /></template>
                                                <template x-if="o.status === 'received'"><twig:ux:icon name="lucide:circle-check" class="h-4 w-4" /></template>
                                                <template x-if="o.status === 'cancelled'"><twig:ux:icon name="lucide:circle-x" class="h-4 w-4" /></template>
                                                <span x-text="o.status"></span>
                                            </div>
                                        </td>
                                        <td class="p-6 text-right">
                                            <div class="flex justify-end gap-2 text-foreground items-center">
                                                <template x-if="o.status === 'pending'">
                                                    <twig:Button x-on:click="handleStatusUpdate(o.id, 'approved')" class="h-10 px-4 bg-primary/10 text-primary hover:bg-primary hover:text-primary-foreground border-primary/20 rounded-xl font-black text-[10px] tracking-widest">APPROVE</twig:Button>
                                                </template>
                                                <twig:Button x-on:click="handleDownloadInvoice(o.id)" class="h-10 px-4 bg-purple-500/10 text-purple-500 hover:bg-purple-500 hover:text-white border-purple-500/20 rounded-xl font-black text-[10px] tracking-widest">
                                                    <twig:ux:icon name="lucide:file-text" class="mr-2 h-4 w-4" />
                                                    INVOICE
                                                </twig:Button>
                                                <template x-if="o.status === 'approved'">
                                                    <twig:Button x-on:click="handleStatusUpdate(o.id, 'received')" class="h-10 px-4 bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500 hover:text-white border-emerald-500/20 rounded-xl font-black text-[10px] tracking-widest">MARK RECEIVED</twig:Button>
                                                </template>
                                                <template x-if="o.status !== 'received' && o.status !== 'cancelled'">
                                                    <twig:Button x-on:click="handleStatusUpdate(o.id, 'cancelled')" variant="ghost" class="h-10 px-4 text-red-500 hover:bg-red-500/10 rounded-xl font-black text-[10px] tracking-widest">CANCEL</twig:Button>
                                                </template>
                                                <template x-if="o.status === 'received'">
                                                    <span class="text-[10px] font-black text-emerald-500 italic uppercase bg-emerald-500/5 px-3 py-1.5 rounded-lg border border-emerald-500/20 shadow-sm items-center">STOCK UPDATED ✓</span>
                                                </template>
                                            </div>
                                        </td>
                                    </tr>
                                </template>
                            </tbody>
                        </table>
                    </div>
                </twig:Card:Content>
            </twig:Card>

            <template x-if="totalPages > 1">
                <div class="flex justify-center items-center gap-4 pb-10">
                    <twig:Button x-on:click="page = Math.max(1, page - 1)" disabledWhen="page === 1" variant="outline" class="rounded-xl font-black text-[10px] tracking-widest uppercase h-10 px-6 border-border hover:bg-secondary transition-all disabled:opacity-30">Previous</twig:Button>
                    <div class="flex items-center gap-2">
                        <template x-for="p in pages" :key="p">
                            <button type="button" @click="page = p" x-text="p" class="w-10 h-10 rounded-xl text-[10px] font-black transition-all"
                                    :class="page === p ? 'bg-primary text-primary-foreground shadow-lg shadow-primary/20' : 'bg-card text-muted-foreground border border-border hover:border-primary/50'"></button>
                        </template>
                    </div>
                    <twig:Button x-on:click="page = Math.min(totalPages, page + 1)" disabledWhen="page === totalPages" variant="outline" class="rounded-xl font-black text-[10px] tracking-widest uppercase h-10 px-6 border-border hover:bg-secondary transition-all disabled:opacity-30">Next</twig:Button>
                </div>
            </template>
        </div>
    </template>
</div>
{% endblock %}
