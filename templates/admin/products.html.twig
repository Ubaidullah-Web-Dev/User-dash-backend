{# Port of app/(tenant)/[companySlug]/admin/products/page.tsx #}
{% extends 'admin/layout.html.twig' %}
{% block pages %}admin-products{% endblock %}
{% set labelClass = 'text-[10px] font-black uppercase tracking-widest text-muted-foreground ml-1' %}
{% block content %}
<div x-data="productsPage">
    <template x-if="loading">
        <div class="py-20 text-center font-black animate-pulse text-primary tracking-widest uppercase italic">Initializing Product Data Flow...</div>
    </template>
    <template x-if="!loading">
        <div class="space-y-12 animate-in fade-in duration-700">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div>
                    <h1 class="text-4xl font-black text-foreground tracking-tighter mb-2 italic uppercase">PRODUCT <span class="text-primary not-italic">Identity</span></h1>
                    <p class="text-muted-foreground font-medium uppercase text-[10px] tracking-widest leading-loose">Global Catalog Control &amp; Marketplace Moderation.</p>
                </div>
                <div>
                    <twig:Button class="bg-primary hover:opacity-90 text-primary-foreground font-black px-10 rounded-2xl h-14 shadow-2xl shadow-primary/20 transition-all active:scale-95 flex items-center gap-3">
                        <twig:ux:icon name="lucide:plus" class="h-5 w-5 group-hover:rotate-90 transition-transform" />
                        DEPLOY NEW PRODUCT
                    </twig:Button>
                </div>
            </div>

            <div class="bg-card border border-border rounded-[2.5rem] overflow-hidden shadow-2xl border-t-4 border-t-secondary/20">
                <div class="px-10 py-6 bg-secondary/20 flex items-center justify-between border-b border-border">
                    <div class="flex items-center text-foreground font-black tracking-widest uppercase text-xs italic">
                        <twig:ux:icon name="lucide:funnel" class="mr-3 h-4 w-4 text-primary" />
                        Refinement Matrix
                    </div>
                    <template x-if="isRefreshing"><twig:ux:icon name="lucide:loader-circle" class="h-4 w-4 text-primary animate-spin" /></template>
                </div>

                <div class="p-10 space-y-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                        <div class="space-y-2">
                            <twig:Label class="{{ labelClass }}">Entity Name</twig:Label>
                            <div class="relative">
                                <twig:ux:icon name="lucide:search" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
                                <twig:Input placeholder="Search by name..." x-model="searchName" class="pl-10 bg-secondary/50 border-border rounded-xl h-11 font-bold focus:ring-primary/20" />
                            </div>
                        </div>
                        <div class="space-y-2">
                            <twig:Label class="{{ labelClass }}">System Hash / ID</twig:Label>
                            <div class="relative">
                                <twig:ux:icon name="lucide:hash" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
                                <twig:Input placeholder="Order ID..." x-model="searchId" class="pl-10 bg-secondary/50 border-border rounded-xl h-11 font-bold focus:ring-primary/20" />
                            </div>
                        </div>
                        <div class="space-y-2">
                            <twig:Label class="{{ labelClass }}">Taxonomy</twig:Label>
                            <twig:Select model="selectedCategory" options="categoryOptions" placeholder="CATEGORY"
                                triggerClass="bg-secondary/50 border-border h-11 rounded-xl text-[10px] font-black uppercase tracking-widest italic px-4"
                                contentClass="bg-white border-border text-foreground rounded-2xl border-t-4 border-t-primary/20 shadow-2xl dark:bg-slate-900" />
                        </div>
                        <div class="space-y-2">
                            <twig:Label class="{{ labelClass }}">Price Range</twig:Label>
                            <div class="flex gap-2">
                                <twig:Input placeholder="MIN" type="number" x-model="minPrice" class="bg-secondary/50 border-border rounded-xl h-11 font-black text-[10px] text-center" />
                                <twig:Input placeholder="MAX" type="number" x-model="maxPrice" class="bg-secondary/50 border-border rounded-xl h-11 font-black text-[10px] text-center" />
                            </div>
                        </div>
                    </div>

                    <div class="pt-6 border-t border-border flex flex-wrap items-center gap-4">
                        <span class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground mr-2">Visibility State:</span>
                        <template x-for="s in statusButtons" :key="s.id">
                            <button type="button" @click="statusFilter = s.id"
                                    class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest border transition-all"
                                    :class="statusFilter === s.id ? 'bg-primary text-primary-foreground border-primary shadow-lg shadow-primary/20' : 'bg-card text-muted-foreground border-border hover:border-primary/50'">
                                <template x-if="s.icon === 'layout-grid'"><twig:ux:icon name="lucide:layout-grid" class="h-3.5 w-3.5" /></template>
                                <template x-if="s.icon === 'zap'"><twig:ux:icon name="lucide:zap" class="h-3.5 w-3.5" /></template>
                                <template x-if="s.icon === 'eye-off'"><twig:ux:icon name="lucide:eye-off" class="h-3.5 w-3.5" /></template>
                                <span x-text="s.label"></span>
                            </button>
                        </template>
                        <div class="ml-auto flex gap-3">
                            <twig:Button x-on:click="handleClearFilters()" variant="outline" class="hover:bg-destructive/10 hover:text-destructive hover:border-destructive/30 font-black text-[10px] tracking-widest h-11 px-8 rounded-xl uppercase transition-all flex items-center gap-2 border-dashed">
                                <twig:ux:icon name="lucide:funnel-x" class="h-4 w-4" /> Reset matrix
                            </twig:Button>
                        </div>
                    </div>
                </div>
            </div>

            <twig:Card class="bg-card border-border rounded-[3rem] shadow-2xl overflow-hidden border-t-4 border-t-primary/20">
                <twig:Card:Header class="p-10 border-b border-border bg-secondary/30 flex flex-row items-center justify-between">
                    <div>
                        <twig:Card:Title class="text-xl font-black tracking-tight flex items-center italic text-foreground uppercase">
                            <twig:ux:icon name="lucide:package" class="mr-4 h-6 w-6 text-primary" />
                            <span x-text="`Global Inventory Output (${totalItems})`"></span>
                        </twig:Card:Title>
                    </div>
                    <template x-if="isRefined">
                        <twig:Badge class="bg-primary/10 text-primary border-primary/20 font-black text-[10px] tracking-widest px-4 py-1.5 rounded-full uppercase italic">REFINED LIST</twig:Badge>
                    </template>
                </twig:Card:Header>
                <twig:Card:Content class="p-0">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead>
                                <tr class="border-b border-border bg-background/50">
                                    <th class="p-8 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground">Entity Identifier</th>
                                    <th class="p-8 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground hidden lg:table-cell">Taxonomy</th>
                                    <th class="p-8 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground text-center">Price Value</th>
                                    <th class="p-8 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground text-center hidden md:table-cell">Priority status</th>
                                    <th class="p-8 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground text-center">Visibility Control</th>
                                    <th class="p-8 text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground text-right border-l border-border/50">System Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border">
                                <template x-if="products.length === 0">
                                    <tr>
                                        <td colspan="6" class="p-24 text-center">
                                            <div class="flex flex-col items-center justify-center space-y-4 opacity-50">
                                                <twig:ux:icon name="lucide:funnel-x" class="h-12 w-12 text-muted-foreground animate-bounce" />
                                                <p class="text-[10px] font-black uppercase tracking-[0.3em] text-muted-foreground italic">No products detected within current refinement parameters</p>
                                            </div>
                                        </td>
                                    </tr>
                                </template>
                                <template x-for="product in products" :key="product.id">
                                    <tr class="hover:bg-primary/5 transition-all duration-300 group">
                                        <td class="p-8">
                                            <div class="flex items-center">
                                                <div class="h-16 w-16 rounded-2xl bg-secondary border border-border mr-6 hidden sm:flex items-center justify-center font-black text-primary text-xl shadow-inner group-hover:bg-primary group-hover:text-primary-foreground transition-all duration-500 group-hover:rotate-12" x-text="product.name?.[0]?.toUpperCase() || 'P'"></div>
                                                <div class="flex flex-col gap-1.5">
                                                    <p class="text-sm font-black text-foreground group-hover:text-primary transition-colors tracking-tighter uppercase italic" x-text="product.name"></p>
                                                    <div class="flex items-center gap-3">
                                                        <span class="flex items-center text-[10px] text-muted-foreground font-black uppercase tracking-widest bg-secondary px-2 py-0.5 rounded-md">
                                                            <twig:ux:icon name="lucide:tag" class="h-3 w-3 mr-1.5 text-primary" /> <span x-text="`ID: ${product.id}`"></span>
                                                        </span>
                                                        <span class="flex items-center text-[10px] font-black uppercase tracking-widest text-primary italic underline decoration-dotted underline-offset-4" x-text="`Stock Level: ${product.stock}`"></span>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="p-8 hidden lg:table-cell">
                                            <div class="flex items-center space-x-2 px-4 py-2 bg-secondary/30 border border-border/50 rounded-xl text-[9px] font-black uppercase tracking-[0.2em] text-foreground shadow-sm">
                                                <twig:ux:icon name="lucide:layout-grid" class="h-3 w-3 text-primary" />
                                                <span x-text="product.category?.name || 'Uncategorized'"></span>
                                            </div>
                                        </td>
                                        <td class="p-8 text-center">
                                            <div class="inline-flex flex-col items-center">
                                                <span class="font-black text-primary text-lg tracking-tighter italic" x-text="`$${parseFloat(product.price).toLocaleString()}`"></span>
                                                <span class="text-[8px] font-black text-muted-foreground uppercase tracking-widest opacity-50">CREDIT VALUE</span>
                                            </div>
                                        </td>
                                        <td class="p-8 text-center hidden md:table-cell">
                                            <template x-if="product.isRecommended">
                                                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/10 text-amber-500 border border-amber-500/20 text-[9px] font-black uppercase tracking-widest animate-pulse">
                                                    <twig:ux:icon name="lucide:zap" class="h-3 w-3" /> FEATURED
                                                </div>
                                            </template>
                                            <template x-if="!product.isRecommended">
                                                <span class="text-[10px] text-muted-foreground font-black opacity-20 uppercase tracking-widest">— STANDARD —</span>
                                            </template>
                                        </td>
                                        <td class="p-8 text-center">
                                            <button type="button" @click="handleToggleActive(product.id)"
                                                    class="group/btn relative h-10 w-24 rounded-xl border flex items-center justify-center transition-all"
                                                    :class="product.isActive ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-500' : 'bg-red-500/10 border-red-500/30 text-red-500'">
                                                <div class="absolute left-1 top-1 h-8 w-8 rounded-lg transition-all flex items-center justify-center"
                                                     :class="product.isActive ? 'bg-emerald-500 text-white shadow-lg shadow-emerald-500/50' : 'bg-red-500 text-white translate-x-14 shadow-lg shadow-red-500/50'">
                                                    <template x-if="product.isActive"><twig:ux:icon name="lucide:circle-check-big" class="h-4 w-4" /></template>
                                                    <template x-if="!product.isActive"><twig:ux:icon name="lucide:eye-off" class="h-4 w-4" /></template>
                                                </div>
                                                <span class="text-[8px] font-black uppercase tracking-wider" :class="product.isActive ? 'ml-6' : 'mr-6'" x-text="product.isActive ? 'LIVE' : 'HIDDEN'"></span>
                                            </button>
                                        </td>
                                        <td class="p-8 text-right border-l border-border/50 bg-secondary/5">
                                            <div class="flex justify-end gap-3">
                                                <div class="group">
                                                    <twig:Button variant="ghost" size="icon" class="h-11 w-11 text-muted-foreground hover:bg-primary/10 hover:text-primary rounded-xl transition-all border border-transparent hover:border-primary/20 cursor-not-allowed">
                                                        <twig:ux:icon name="lucide:eye" class="h-5 w-5" />
                                                    </twig:Button>
                                                </div>
                                                <twig:Button variant="ghost" size="icon" x-on:click="handleDelete(product.id)" class="h-11 w-11 text-muted-foreground hover:bg-destructive/10 hover:text-destructive rounded-xl transition-all hover:scale-110 active:scale-90 border border-transparent hover:border-destructive/20">
                                                    <twig:ux:icon name="lucide:trash-2" class="h-5 w-5" />
                                                </twig:Button>
                                            </div>
                                        </td>
                                    </tr>
                                </template>
                            </tbody>
                        </table>
                    </div>
                </twig:Card:Content>

                <div class="p-8 border-t border-border bg-secondary/10 flex flex-col md:flex-row items-center justify-between gap-6">
                    <div class="flex items-center gap-4">
                        <div class="flex items-center px-4 py-2 bg-background border border-border rounded-xl shadow-inner">
                            <span class="text-[10px] font-black text-muted-foreground uppercase tracking-widest mr-3">Matrix Density:</span>
                            <select x-model.number="itemsPerPage" @change="currentPage = 1" class="bg-transparent border-none text-[10px] font-black text-primary uppercase focus:ring-0 cursor-pointer">
                                {% for v in [10, 25, 50, 100] %}<option value="{{ v }}" class="bg-card text-foreground">{{ v }} ENTITIES / PAGE</option>{% endfor %}
                            </select>
                        </div>
                        <p class="text-[10px] font-black text-muted-foreground uppercase tracking-widest ml-2 whitespace-nowrap">
                            Showing <span class="text-primary" x-text="products.length"></span> of <span class="text-foreground" x-text="totalItems"></span> sync'd nodes
                        </p>
                    </div>

                    <div class="flex items-center gap-2">
                        <twig:Button variant="outline" size="icon" disabledWhen="currentPage === 1 || loading" x-on:click="currentPage = Math.max(1, currentPage - 1)" class="h-11 w-11 rounded-xl border-border bg-card hover:bg-primary/10 hover:text-primary transition-all disabled:opacity-30">
                            <twig:ux:icon name="lucide:chevron-left" class="h-4 w-4" />
                        </twig:Button>
                        <div class="flex items-center gap-1.5 px-3 py-1.5 bg-background border border-border rounded-2xl shadow-inner">
                            <template x-for="pageNum in pageNumbers" :key="pageNum">
                                <button type="button" @click="currentPage = pageNum" x-text="pageNum.toString().padStart(2, '0')"
                                        class="h-8 w-8 rounded-lg text-[10px] font-black tracking-tighter transition-all"
                                        :class="currentPage === pageNum ? 'bg-primary text-primary-foreground shadow-lg shadow-primary/30 scale-110' : 'bg-transparent text-muted-foreground hover:bg-primary/10 hover:text-primary'"></button>
                            </template>
                        </div>
                        <twig:Button variant="outline" size="icon" disabledWhen="currentPage === totalPages || loading" x-on:click="currentPage = Math.min(totalPages, currentPage + 1)" class="h-11 w-11 rounded-xl border-border bg-card hover:bg-primary/10 hover:text-primary transition-all disabled:opacity-30">
                            <twig:ux:icon name="lucide:chevron-right" class="h-4 w-4" />
                        </twig:Button>
                    </div>
                </div>
            </twig:Card>
        </div>
    </template>
</div>
{% endblock %}
