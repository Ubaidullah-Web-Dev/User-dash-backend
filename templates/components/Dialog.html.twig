{#
    Port of components/ui/dialog.tsx.
    <twig:Dialog open="isOpen" close="isOpen = false" title="'Static title'" description="`Dynamic ${x}`" class="max-w-2xl">…</twig:Dialog>
    open/close/title/description are Alpine expressions.
#}
{% props open, close, title = null, description = null %}
<template x-if="{{ open }}">
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4" x-data="uiDialog"
         @keydown.escape.window="{{ close }}">
        <div class="absolute inset-0 bg-background/80 backdrop-blur-sm animate-in fade-in duration-200" @click="{{ close }}"></div>
        <div class="{{ ('relative z-50 w-full max-w-lg bg-card border border-border rounded-3xl shadow-2xl animate-in zoom-in-95 fade-in duration-200 overflow-hidden ' ~ attributes.render('class'))|tailwind_merge }}">
            <div class="flex flex-col p-6 space-y-4">
                <div class="flex items-center justify-between">
                    <div class="space-y-1">
                        {% if title %}<h2 class="text-xl font-bold tracking-tight uppercase" x-show="{{ title }}" x-text="{{ title }}"></h2>{% endif %}
                        {% if description %}<p class="text-xs text-muted-foreground font-medium uppercase tracking-wider" x-show="{{ description }}" x-text="{{ description }}"></p>{% endif %}
                    </div>
                    <button type="button" @click="{{ close }}" class="p-2 rounded-xl hover:bg-secondary/50 transition-colors text-muted-foreground hover:text-foreground">
                        {{ ux_icon('lucide:x', {class: 'h-5 w-5'}) }}
                    </button>
                </div>
                <div class="py-2">
                    {% block content %}{% endblock %}
                </div>
            </div>
        </div>
    </div>
</template>