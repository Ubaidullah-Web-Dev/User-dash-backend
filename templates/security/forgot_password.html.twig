{# Port of app/(tenant)/[companySlug]/forgot-password/page.tsx #}
{% extends 'base.html.twig' %}
{% block pages %}forgot-password{% endblock %}
{% block body %}
<div class="flex min-h-screen items-center justify-center bg-white dark:bg-gray-950 px-4 relative overflow-hidden" x-data="forgotPasswordPage">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-cyan-500/5 blur-[150px] rounded-full pointer-events-none"></div>
    <twig:Card class="w-full max-w-md border-gray-800/50 bg-gray-900/40 backdrop-blur-2xl">
        <twig:Card:Header class="space-y-1 pb-8 text-center">
            <twig:Card:Title class="text-3xl font-extrabold tracking-tight bg-gradient-to-r from-white to-gray-400 bg-clip-text text-transparent"
                x-text="step === 'EMAIL' ? 'Reset Password' : (step === 'OTP' ? 'Verify Code' : 'New Password')">Reset Password</twig:Card:Title>
            <twig:Card:Description class="text-gray-500 dark:text-gray-400 text-base"
                x-text="step === 'EMAIL' ? 'Enter your email to receive a 6-digit code' : (step === 'OTP' ? `We sent a code to ${email}` : 'Choose a strong password for your account')">Enter your email to receive a 6-digit code</twig:Card:Description>
        </twig:Card:Header>

        <template x-if="step === 'EMAIL'">
            <form @submit.prevent="handleRequestCode()">
                <twig:Card:Content class="space-y-4">
                    <div class="relative">
                        <twig:ux:icon name="lucide:mail" class="absolute left-3.5 top-3 h-5 w-5 text-gray-400 dark:text-gray-500" />
                        <twig:Input type="email" placeholder="Email Address" class="pl-11" required x-model="email" />
                    </div>
                </twig:Card:Content>
                <twig:Card:Footer class="flex flex-col gap-4">
                    <twig:Button class="w-full h-12 text-base rounded-2xl group" loading="isLoading" type="submit">
                        Send Code
                        <template x-if="!isLoading"><twig:ux:icon name="lucide:arrow-right" class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1" /></template>
                    </twig:Button>
                    <a href="/{{ companySlug }}/login" class="flex items-center justify-center text-sm text-gray-400 dark:text-gray-500 hover:text-gray-400 transition-colors">
                        <twig:ux:icon name="lucide:arrow-left" class="mr-2 h-4 w-4" /> Back to Login
                    </a>
                </twig:Card:Footer>
            </form>
        </template>

        <template x-if="step === 'OTP'">
            <form @submit.prevent="handleVerifyCode()">
                <twig:Card:Content class="space-y-4">
                    <div class="relative">
                        <twig:ux:icon name="lucide:fingerprint-pattern" class="absolute left-3.5 top-3 h-5 w-5 text-gray-400 dark:text-gray-500" />
                        <twig:Input type="text" placeholder="6-digit Code" class="pl-11 tracking-widest text-center text-xl font-bold font-mono" required maxlength="6" x-model="code" />
                    </div>
                </twig:Card:Content>
                <twig:Card:Footer class="flex flex-col gap-4">
                    <twig:Button class="w-full h-12 text-base rounded-2xl group" loading="isLoading" type="submit">
                        Verify Code
                        <template x-if="!isLoading"><twig:ux:icon name="lucide:arrow-right" class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1" /></template>
                    </twig:Button>
                    <button type="button" @click="step = 'EMAIL'" class="text-sm text-gray-400 dark:text-gray-500 hover:text-gray-400 transition-colors">Change Email</button>
                </twig:Card:Footer>
            </form>
        </template>

        <template x-if="step === 'PASSWORD'">
            <form @submit.prevent="handleResetPassword()">
                <twig:Card:Content class="space-y-4">
                    <div class="relative">
                        <twig:ux:icon name="lucide:lock" class="absolute left-3.5 top-3 h-5 w-5 text-gray-400 dark:text-gray-500" />
                        <twig:Input type="password" placeholder="New Password" class="pl-11" required minlength="6" x-model="password" />
                    </div>
                    <div class="relative">
                        <twig:ux:icon name="lucide:shield-check" class="absolute left-3.5 top-3 h-5 w-5 text-gray-400 dark:text-gray-500" />
                        <twig:Input type="password" placeholder="Confirm New Password" class="pl-11" required minlength="6" x-model="confirmPassword" />
                    </div>
                </twig:Card:Content>
                <twig:Card:Footer>
                    <twig:Button class="w-full h-12 text-base rounded-2xl group" loading="isLoading" type="submit">
                        Update Password
                        <template x-if="!isLoading"><twig:ux:icon name="lucide:arrow-right" class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1" /></template>
                    </twig:Button>
                </twig:Card:Footer>
            </form>
        </template>
    </twig:Card>
</div>
{% endblock %}
