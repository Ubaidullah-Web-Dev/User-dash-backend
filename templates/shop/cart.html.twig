{# Port of app/(tenant)/[companySlug]/cart/page.tsx #}
{% extends 'base.html.twig' %}
{% block pages %}cart{% endblock %}
{% block body %}
<div x-data="cartPage">
    <template x-if="loading">
        <div class="min-h-screen flex items-center justify-center text-primary font-black uppercase tracking-widest">SYNCING CART...</div>
    </template>
    <template x-if="!loading">
        <div class="min-h-screen bg-background text-foreground">
            <div class="max-w-7xl mx-auto px-4 py-12">
                <h1 class="text-4xl font-black text-foreground mb-10 flex items-center tracking-tighter">
                    <twig:ux:icon name="lucide:shopping-bag" class="mr-4 h-10 w-10 text-primary" />
                    MY <span class="text-primary ml-2 uppercase">shopping bag</span>
                </h1>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                    <div class="lg:col-span-2 space-y-12">
                        <div class="space-y-6">
                            <div class="flex justify-between items-center px-4">
                                <h2 class="text-xl font-bold text-foreground" x-text="`Current Items (${cartItems.length})`"></h2>
                                <template x-if="cartItems.length > 0">
                                    <twig:Button variant="ghost" class="text-muted-foreground hover:text-red-500 text-xs font-black">CLEAR ALL</twig:Button>
                                </template>
                            </div>

                            <template x-if="cartItems.length === 0">
                                <twig:Card class="bg-card border-border border-dashed rounded-4xl py-16 text-center shadow-sm">
                                    <twig:ux:icon name="lucide:shopping-bag" class="mx-auto h-16 w-16 text-muted-foreground mb-4 opacity-20" />
                                    <p class="text-muted-foreground font-medium mb-6">Your bag is empty. Let&apos;s find something cool!</p>
                                    <a href="/{{ companySlug }}/marketplace">
                                        <twig:Button class="bg-primary hover:opacity-90 text-primary-foreground rounded-xl px-10 font-black h-12">START SHOPPING</twig:Button>
                                    </a>
                                </twig:Card>
                            </template>
                            <template x-for="item in cartItems" :key="item.id">
                                <twig:Card class="bg-card border-border rounded-4xl overflow-hidden group hover:border-primary/30 transition-all shadow-sm">
                                    <div class="p-6 flex flex-col sm:flex-row gap-6 items-center">
                                        <div class="h-32 w-32 rounded-2xl overflow-hidden border border-border shrink-0 relative bg-secondary">
                                            <twig:NextImage src="item.productImage || 'https://images.unsplash.com/photo-1526733170371-33157ae37812'" alt="item.productName" class="w-full h-full object-cover" />
                                        </div>
                                        <div class="flex-1 space-y-2 text-center sm:text-left">
                                            <h3 class="text-lg font-bold text-foreground group-hover:text-primary transition-colors" x-text="item.productName"></h3>
                                            <p class="text-muted-foreground font-medium text-sm">Quantity: <span class="text-foreground font-bold" x-text="item.quantity"></span></p>
                                            <h4 class="text-2xl font-black text-foreground" x-text="`$${parseFloat(item.productPrice).toLocaleString()}`"></h4>
                                        </div>
                                        <div class="flex flex-row sm:flex-col gap-2">
                                            <twig:Button variant="ghost" size="icon" class="h-12 w-12 rounded-xl hover:bg-red-500/10 hover:text-red-500 text-muted-foreground" x-on:click="handleRemove(item.id)">
                                                <twig:ux:icon name="lucide:trash-2" class="h-5 w-5" />
                                            </twig:Button>
                                            <twig:Button variant="ghost" size="icon" class="h-12 w-12 rounded-xl hover:bg-primary/10 hover:text-primary text-muted-foreground" x-on:click="handleToggleSave(item.id)">
                                                <twig:ux:icon name="lucide:heart" class="h-5 w-5" />
                                            </twig:Button>
                                        </div>
                                    </div>
                                </twig:Card>
                            </template>
                        </div>

                        <template x-if="savedItems.length > 0">
                            <div class="space-y-6 pt-10 border-t border-border">
                                <h2 class="text-xl font-bold text-foreground px-4 flex items-center">
                                    <twig:ux:icon name="lucide:heart" class="mr-3 h-5 w-5 text-red-500 animate-pulse" /> Saved for Later
                                </h2>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                    <template x-for="item in savedItems" :key="item.id">
                                        <twig:Card class="bg-card border-border rounded-3xl overflow-hidden grayscale hover:grayscale-0 transition-all opacity-70 hover:opacity-100 shadow-sm">
                                            <div class="p-6 flex gap-4">
                                                <div class="h-20 w-20 rounded-xl overflow-hidden shrink-0 relative bg-secondary border border-border">
                                                    <twig:NextImage src="item.productImage || 'https://images.unsplash.com/photo-1526733170371-33157ae37812'" alt="item.productName" class="object-cover" />
                                                </div>
                                                <div class="flex-1">
                                                    <h4 class="font-bold text-muted-foreground text-sm line-clamp-1" x-text="item.productName"></h4>
                                                    <p class="text-foreground font-black mb-3" x-text="`$${parseFloat(item.productPrice).toLocaleString()}`"></p>
                                                    <twig:Button variant="link" class="p-0 h-auto text-primary hover:text-primary/80 text-xs font-black tracking-widest" x-on:click="handleToggleSave(item.id)">
                                                        MOVE TO BAG <twig:ux:icon name="lucide:arrow-right" class="ml-2 h-3 w-3" />
                                                    </twig:Button>
                                                </div>
                                            </div>
                                        </twig:Card>
                                    </template>
                                </div>
                            </div>
                        </template>
                    </div>

                    <div class="lg:col-span-1">
                        <twig:Card class="bg-card border-border rounded-[2.5rem] sticky top-32 overflow-hidden shadow-xl border-t-4 border-t-primary/20">
                            <div class="p-10 space-y-8">
                                <h3 class="text-2xl font-black text-foreground uppercase tracking-tight">Summary</h3>
                                <div class="space-y-4">
                                    <div class="flex justify-between text-muted-foreground font-medium">
                                        <span>Subtotal</span>
                                        <span class="font-bold text-foreground" x-text="`$${subtotal.toLocaleString()}`"></span>
                                    </div>
                                    <div class="flex justify-between text-muted-foreground font-medium">
                                        <span>Shipping</span>
                                        <span class="font-bold text-emerald-500" x-text="shipping === 0 ? 'FREE' : `$${shipping}`"></span>
                                    </div>
                                    <div class="pt-6 border-t border-border flex justify-between items-end">
                                        <span class="text-foreground font-bold text-sm uppercase tracking-widest">Total Amount</span>
                                        <span class="text-4xl font-black text-foreground tracking-tighter" x-text="`$${total.toLocaleString()}`"></span>
                                    </div>
                                </div>

                                <a href="/{{ companySlug }}/checkout/address">
                                    <twig:Button class="w-full h-16 bg-primary text-primary-foreground hover:opacity-90 rounded-2xl font-black text-lg shadow-lg shadow-primary/20 transition-all active:scale-[0.98] my-5">
                                        CHECKOUT <twig:ux:icon name="lucide:credit-card" class="ml-3 h-6 w-6" />
                                    </twig:Button>
                                </a>

                                <div class="space-y-4">
                                    <div class="flex items-center text-[10px] font-black uppercase text-muted-foreground bg-secondary/50 p-4 rounded-xl border border-border">
                                        <twig:ux:icon name="lucide:truck" class="h-4 w-4 mr-3 text-primary" />
                                        <span>Free delivery on orders over $500</span>
                                    </div>
                                    <div class="flex items-center text-[10px] font-black uppercase text-muted-foreground bg-secondary/50 p-4 rounded-xl border border-border">
                                        <svg class="h-4 w-4 mr-3 text-purple-500" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></svg>
                                        <span>30-day effortless returns policy</span>
                                    </div>
                                </div>
                            </div>
                        </twig:Card>
                    </div>
                </div>
            </div>
        </div>
    </template>
</div>
{% endblock %}
