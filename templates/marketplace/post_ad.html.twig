{# Port of app/(tenant)/[companySlug]/marketplace/post-ad/page.tsx #}
{% extends 'marketplace/layout.html.twig' %}
{% block pages %}post-ad{% endblock %}
{% block content %}
<div class="py-12 px-4 max-w-4xl mx-auto" x-data="postAdPage">
    <div class="mb-12 text-center">
        <twig:Badge variant="outline" class="mb-4 border-primary/50 text-primary font-bold px-4 py-1">SELLER PORTAL</twig:Badge>
        <h1 class="text-5xl font-black text-foreground mb-4 tracking-tight flex items-center justify-center">
            <twig:ux:icon name="lucide:sparkles" class="mr-4 h-10 w-10 text-primary animate-pulse" />
            POST YOUR <span class="text-primary">AD</span>
        </h1>
        <p class="text-muted-foreground font-medium text-lg">Reach thousands of tech enthusiasts with your premium products.</p>
    </div>

    <twig:Card class="bg-card border-border rounded-[2.5rem] overflow-hidden shadow-2xl">
        <twig:Card:Header class="bg-linear-to-b from-secondary/30 to-transparent p-10 border-b border-border">
            <twig:Card:Title class="text-2xl font-bold flex items-center text-foreground">
                <twig:ux:icon name="lucide:package" class="mr-3 h-7 w-7 text-primary" />
                Product Information
            </twig:Card:Title>
        </twig:Card:Header>
        <twig:Card:Content class="p-10">
            <form @submit.prevent="handleSubmit()" class="space-y-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-3">
                        <twig:Label for="name" class="text-muted-foreground font-bold uppercase text-xs tracking-widest pl-1">Product Title</twig:Label>
                        <twig:Input id="name" name="name" placeholder="e.g. MacBook Pro M3 Max" class="h-14 bg-secondary/50 border-border rounded-2xl focus:ring-primary/20 px-6 font-medium" x-model="formData.name" required />
                    </div>

                    <div class="space-y-3">
                        <twig:Label class="text-muted-foreground font-bold uppercase text-xs tracking-widest pl-1">Category</twig:Label>
                        <twig:Select model="formData.category_id" options="categoryOptions" placeholder="Select a Category" required
                            triggerClass="h-14 bg-secondary/50 border-border rounded-2xl px-6" contentClass="bg-card border-border text-foreground"
                            itemClass="focus:bg-primary/10 focus:text-primary" />
                    </div>

                    <div class="space-y-3">
                        <twig:Label for="price" class="text-muted-foreground font-bold uppercase text-xs tracking-widest pl-1">Price (PKR)</twig:Label>
                        <div class="relative">
                            <twig:ux:icon name="lucide:dollar-sign" class="absolute left-6 top-1/2 -translate-y-1/2 h-5 w-5 text-muted-foreground" />
                            <twig:Input id="price" name="price" type="number" step="0.01" placeholder="0.00" class="h-14 bg-secondary/50 border-border rounded-2xl pl-14 pr-6 font-bold text-lg text-primary" x-model="formData.price" required />
                        </div>
                    </div>

                    <div class="space-y-3">
                        <twig:Label for="stock" class="text-muted-foreground font-bold uppercase text-xs tracking-widest pl-1">Available Stock</twig:Label>
                        <twig:Input id="stock" name="stock" type="number" class="h-14 bg-secondary/50 border-border rounded-2xl px-6" x-model="formData.stock" required />
                    </div>

                    <div class="space-y-3">
                        <twig:Label for="unit" class="text-muted-foreground font-bold uppercase text-xs tracking-widest pl-1">Unit (e.g. kg, gram, pcs)</twig:Label>
                        <twig:Input id="unit" name="unit" placeholder="Enter unit name" class="h-14 bg-secondary/50 border-border rounded-2xl px-6" x-model="formData.unit" />
                    </div>
                </div>

                <div class="space-y-3">
                    <twig:Label for="description" class="text-muted-foreground font-bold uppercase text-xs tracking-widest pl-1">Product Narrative</twig:Label>
                    <textarea id="description" name="description" placeholder="Describe the item in detail, its condition, box contents, etc..."
                              class="w-full h-40 bg-secondary/50 border border-border rounded-3xl p-8 focus:ring-2 focus:ring-primary/20 outline-none transition-all text-foreground scrollbar-hide"
                              x-model="formData.description" required></textarea>
                </div>

                <div class="space-y-6 pt-4 border-t border-border">
                    <div class="flex justify-between items-center px-1">
                        <twig:Label class="text-muted-foreground font-bold uppercase text-xs tracking-widest">Image URLs</twig:Label>
                        <twig:Button type="button" variant="ghost" class="text-primary hover:text-primary/80 text-xs font-bold" x-on:click="addImageField()">
                            <twig:ux:icon name="lucide:plus" class="mr-2 h-4 w-4" /> ADD IMAGE
                        </twig:Button>
                    </div>
                    <div class="grid grid-cols-1 gap-4">
                        <template x-for="(img, idx) in formData.images" :key="idx">
                            <div class="flex gap-4 group">
                                <div class="relative flex-1">
                                    <twig:ux:icon name="lucide:camera" class="absolute left-5 top-1/2 -translate-y-1/2 h-5 w-5 text-muted-foreground group-hover:text-primary transition-colors" />
                                    <twig:Input placeholder="https://example.com/image.jpg" class="h-14 bg-secondary/50 border-border rounded-2xl pl-14 pr-6" x-model="formData.images[idx]" />
                                </div>
                                <template x-if="formData.images.length > 1">
                                    <twig:Button type="button" variant="ghost" class="h-14 w-14 rounded-2xl text-muted-foreground hover:text-red-500 hover:bg-red-500/10" x-on:click="removeImageField(idx)">
                                        <twig:ux:icon name="lucide:trash-2" class="h-5 w-5" />
                                    </twig:Button>
                                </template>
                            </div>
                        </template>
                    </div>
                </div>

                <div class="pt-6">
                    <twig:Button type="submit" class="w-full h-16 bg-primary hover:opacity-90 text-primary-foreground font-black text-xl rounded-2xl shadow-xl shadow-primary/20 transition-all active:scale-95" disabledWhen="loading">
                        <template x-if="loading"><twig:ux:icon name="lucide:loader-circle" class="mr-3 h-6 w-6 animate-spin" /></template>
                        <template x-if="!loading"><twig:ux:icon name="lucide:plus" class="mr-3 h-6 w-6" /></template>
                        PUBLISH AD
                    </twig:Button>
                </div>
            </form>
        </twig:Card:Content>
    </twig:Card>
</div>
{% endblock %}
