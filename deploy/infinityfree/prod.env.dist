# InfinityFree production settings. Copy this file to prod.env (git-ignored) and fill it in:
#     cp deploy/infinityfree/prod.env.dist deploy/infinityfree/prod.env
# All values come from the InfinityFree client area -> your account -> "MySQL Databases" / "FTP Details".

# --- Database ("MySQL Databases" page) ---
DB_HOST=sql000.infinityfree.com
DB_PORT=3306
DB_NAME=if0_00000000_lab
DB_USER=if0_00000000
DB_PASSWORD=change-me
# Shown on the phpMyAdmin home page as "Server version". Examples: mariadb-10.6.0, mariadb-11.4.0, 8.0.36 (MySQL)
DB_SERVER_VERSION=mariadb-10.6.0

# --- Email (password-reset codes). Leave empty to reuse MAILER_DSN from your local .env ---
MAILER_DSN=

# --- Secrets. Leave empty: build.sh generates them the first time and writes them back here ---
APP_SECRET=
JWT_PASSPHRASE=

# --- FTP ("FTP Details" page). Only needed for upload.py ---
FTP_HOST=ftpupload.net
FTP_PORT=21
FTP_USER=if0_00000000
FTP_PASSWORD=change-me
